// WC3 Inventory Bucket Flow — how quantities move through the system
// Render: dot -Tpdf wc3-inventory-buckets.dot -o wc3-inventory-buckets.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_inventory_buckets {
    size="10.0,7.5"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=LR
    label="WC3 — Inventory Bucket Flow\navailable = on_hand - allocated"
    labelloc=t

    // Transactions
    proposal [label="Proposal\n(forecast)" shape=box fillcolor="#E8DAEF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/proposal.py" target="_blank" tooltip="Sales proposal — forecast. on_p tracks weighted probability.\nModel: apps/transactions/models/proposal.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (converts proposal to order)\nPending deltas: on_p: +qty_x_prob"]
    order [label="Order\n(commitment)" shape=box fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/order.py" target="_blank" tooltip="Sales order — customer commitment. Creates +on_so and -on_p pending records.\nModel: apps/transactions/models/order.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (creates order from proposal)
  _create_transfer_pending_records @ apps/transactions/services/proposal_to_order.py:131 (pending records for +on_so, -on_p)\nPending deltas: on_so: +qty, on_p: -qty"]
    invoice [label="Invoice\n(shipment)" shape=box fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/invoice.py" target="_blank" tooltip="Invoice — shipment event. Financial event triggers GL and inventory movement.\nModel: apps/transactions/models/invoice.py\nFunctions:
  transfer_order_to_invoice @ apps/transactions/services/order_to_invoice.py:16 (creates invoice from order)
  Pending.objects.create @ apps/transactions/services/order_to_invoice.py:332 (-on_hand, -on_so, +on_in)\nPending deltas: on_hand: -qty, on_so: -qty, on_in: +qty\nGL: AR debit, Revenue credit, Tax credit, COGS debit, Inventory credit, Commission"]
    purchase [label="Purchase\nOrder" shape=box fillcolor="#D4E6F1" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/purchase.py" target="_blank" tooltip="Purchase order to vendor. GAP: +on_po pending record is NOT created.\nModel: apps/transactions/models/purchase.py\nFunctions:
  transfer_order_to_purchase @ apps/transactions/services/order_to_purchase.py:14 (creates PO from order)
  transfer_proposal_to_purchase @ apps/transactions/services/proposal_to_purchase.py:13 (creates PO from proposal)\nPending deltas: on_po: +qty (GAP: not implemented — no Pending.objects.create)"]
    receipt [label="Receipt\n(inship)" shape=box fillcolor="#AED6F1" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/receipt.py" target="_blank" tooltip="Receipt of purchased goods. Creates pending for +on_hand, -on_po.\nModel: apps/transactions/models/receipt.py\nFunctions:
  receive_purchase @ apps/transactions/services/flow.py:219 (receipt processing)
  Pending.objects.create @ apps/transactions/services/flow.py:308 (+on_hand, -on_po)\nPending deltas: on_hand: +qty, on_po: -qty"]
    workorder [label="Work Order\n(production)" shape=box fillcolor="#FADBD8" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/workorder.py" target="_blank" tooltip="Work order completion — production items enter inventory.\nModel: apps/transactions/models/workorder.py\nFunctions:
  complete_workorder @ apps/transactions/services/flow.py:361 (WO completion)
  Pending.objects.create @ apps/transactions/services/flow.py:452 (+on_hand, -on_wo)\nPending deltas: on_hand: +qty, on_wo: -qty"]
    wo_complete [label="WO\nCompletion" shape=box fillcolor="#F5B7B1" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/services/flow.py:361" target="_blank" tooltip="Work order completion event. Same service as workorder.\nFunctions:
  complete_workorder @ apps/transactions/services/flow.py:361 (WO completion processing)\nPending deltas: on_hand: +qty, on_wo: -qty"]

    // Buckets
    on_p [label="on_p\n(forecast)" shape=ellipse fillcolor="#D7BDE2" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="Forecast quantity from proposals — weighted by probability.\nFunctions:
  Item.quantity['on_p'] @ apps/products/models/item.py:238 (forecast from proposals)"]
    on_so [label="on_so\n(committed)" shape=ellipse fillcolor="#F9E79F" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="Committed to sales orders — reduces available.\nFunctions:
  Item.quantity['on_so'] @ apps/products/models/item.py:238 (committed to sales orders)"]
    on_hand [label="on_hand\n(physical)" shape=ellipse fillcolor="#82E0AA" fontsize=12 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="Physical inventory — what is in the warehouse.\nFunctions:
  Item.quantity['on_hand'] @ apps/products/models/item.py:238 (physical inventory count)"]
    allocated [label="allocated\n(reserved)" shape=ellipse fillcolor="#FAD7A0" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:269" target="_blank" tooltip="Reserved inventory — committed to sales orders. Subtracted from on_hand to get available.\nFunctions:
  Item.quantity['allocated'] @ apps/products/models/item.py:269 (reserved for committed orders)"]
    on_po [label="on_po\n(expected)" shape=ellipse fillcolor="#85C1E9" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="Expected from purchase orders — increases available.\nFunctions:
  Item.quantity['on_po'] @ apps/products/models/item.py:238 (expected from purchase orders)"]
    on_wo [label="on_wo\n(in production)" shape=ellipse fillcolor="#F1948A" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="In production via work orders — increases available.\nFunctions:
  Item.quantity['on_wo'] @ apps/products/models/item.py:238 (in production)"]
    on_in [label="on_in\n(invoiced)" shape=ellipse fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="Invoiced — goods that have been shipped.\nFunctions:
  Item.quantity['on_in'] @ apps/products/models/item.py:238 (invoiced/shipped)"]
    on_r [label="on_r\n(returns)" shape=ellipse fillcolor="#D5F5E3" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:238" target="_blank" tooltip="Returns pending — goods expected back from customers.\nFunctions:
  Item.quantity['on_r'] @ apps/products/models/item.py:238 (returns pending)"]

    available [label="AVAILABLE\non_hand - allocated" shape=doublecircle fillcolor="#58D68D" fontsize=11 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:493" target="_blank" tooltip="Computed available quantity: on_hand - allocated. Recomputed on save.\nFunctions:
  Item.save @ apps/products/models/item.py:493 (available = on_hand - allocated)"]

    // Flows
    proposal -> on_p [label="+qty×prob" color="#8E44AD"]
    order -> on_so [label="+qty" color="#F39C12"]
    order -> on_p [label="-qty (partial)" style=dashed color="#8E44AD"]

    invoice -> on_so [label="-qty" color="#E74C3C"]
    invoice -> on_in [label="+qty" color="#27AE60"]
    on_in -> on_hand [label="-qty" color="#E74C3C"]

    purchase -> on_po [label="+qty" color="#2980B9"]
    receipt -> on_hand [label="+qty" color="#27AE60"]
    on_po -> receipt [label="-qty" color="#E74C3C"]

    workorder -> on_wo [label="+qty" color="#C0392B"]
    wo_complete -> receipt [label="creates" style=dashed color="#2980B9"]
    on_wo -> wo_complete [label="-qty" color="#E74C3C"]

    // Available computation
    on_hand -> available [style=bold color="#27AE60"]
    allocated -> available [label="-" style=bold color="#E74C3C"]
}
