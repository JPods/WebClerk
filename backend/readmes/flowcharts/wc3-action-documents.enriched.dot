// WC3 Action Documents — uploading images, videos, and files to Action records
// Shows the attachment pipeline: upload → Document → LinkageEntry → Action
// Render: dot -Tpdf wc3-action-documents.dot -o wc3-action-documents.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_action_documents {
    size="10.0,7.5"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — Action Documents\nUpload images, videos, and files to Action records"
    labelloc=t

    // Upload entry
    upload [label="File Upload\n\nimage/png\nimage/jpeg\nvideo/mp4\napplication/pdf\nany mime_type" shape=box fillcolor="#85C1E9" fontsize=9 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/docs/views_upload.py:1" target="_blank" tooltip="File upload pipeline — checksum, inline encode, EXIF extract, virus scan, create Document.\nService: apps/docs/views_upload.py\nFunctions:
  upload_view @ apps/docs/views_upload.py:46 (inline encoding: zlib+base64 for small files)
  checksum computation @ apps/docs/views_upload.py:73 (SHA256 dedup check)"]

    // Processing
    checksum [label="SHA256\nChecksum\n\ndedup check" shape=box fillcolor="#D5D8DC" fontsize=9]
    inline_encode [label="Inline Encoding\n\nzlib + base64\nstored in config" shape=box fillcolor="#D5D8DC" fontsize=9]
    exif_extract [label="EXIF Extraction\n\ncamera, datetime\nwidth, height\ngps coordinates" shape=box fillcolor="#D5D8DC" fontsize=9]
    virus_scan [label="Virus Scan\n\nscanner, status\nthreat, quarantined" shape=box fillcolor="#FADBD8" fontsize=9]

    // Document record
    document [label="Document\n\nname\nmime_type\nsize_bytes\nchecksum\npath.storage\npath.key\nconfig.inline_content_b64\nmetadata.exif\nmetadata.virus" shape=box fillcolor="#8E44AD" fontcolor=white fontsize=9 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/docs/models/document.py:22" target="_blank" tooltip="File storage — images, videos, PDFs. Inline-encoded in config or external path. EXIF extraction, virus scan.\nModel: apps/docs/models/document.py:22\nFunctions:
  Document.increment_access @ apps/docs/models/document.py:76 (atomic access counter + history)"]

    // LinkageEntry
    linkage_parent [label="LinkageEntry\n(parent)\n\nmodel_name='action'\nrecord_id=action.id\npurpose='attachment'\nrole='parent'" shape=box fillcolor="#82E0AA" fontsize=9 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/docs/models/linkage_entry.py:28" target="_blank" tooltip="LinkageEntry parent — clusters action with its attached documents via group_id.\nModel: apps/docs/models/linkage_entry.py:28\nFunctions:
  LinkageEntry.next_group_id @ apps/docs/models/linkage_entry.py:100 (generates next group_id for clustering)"]
    linkage_child [label="LinkageEntry\n(child)\n\nmodel_name='document'\nrecord_id=doc.id\npurpose='attachment'\nrole='child'" shape=box fillcolor="#82E0AA" fontsize=9 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/docs/models/linkage_entry.py:28" target="_blank" tooltip="LinkageEntry child — document attached to action. Same group_id as parent.\nModel: apps/docs/models/linkage_entry.py:28"]

    // Action
    action [label="Action\n\n_pending_attachments[]\npre_save captures\npost_save creates linkage" shape=diamond fillcolor="#F4D03F" fontsize=9 URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/core/models/action.py:10" target="_blank" tooltip="Universal task — who, what, why, when, where, how. References any record. Tracks communication touches.\nModel: apps/core/models/action.py:10\nFunctions:
  Action._pending_attachments @ apps/core/models/action.py:198 (pre_save captures attachment list)
  Action.post_save (linkage) @ apps/core/models/action.py:230 (creates LinkageEntry group for documents)
  Action.contact_id resolve @ apps/core/models/action.py:285 (auto-resolves contact from assigned_to)"]

    // Multiple documents
    doc2 [label="Document 2\n(another file)" shape=box fillcolor="#8E44AD" fontcolor=white fontsize=9]
    linkage_child2 [label="LinkageEntry\n(child 2)" shape=box fillcolor="#82E0AA" fontsize=9]

    // Access
    access [label="Access & Display\n\ncount_accessed++\nmetadata.history.accessed\nretention_period" shape=box fillcolor="#F5B7B1" fontsize=9]

    // Group
    group_id [label="group_id\n\nclusters all entries\nfor one attachment set\nnext_group_id()" shape=note fillcolor="#FDFEFE" fontsize=8]

    // Flow
    upload -> checksum [label="compute hash"]
    upload -> inline_encode [label="small files"]
    upload -> exif_extract [label="images" style=dashed]
    upload -> virus_scan [label="all files" style=dashed]

    checksum -> document [label="create record"]
    inline_encode -> document [label="config.inline_*"]
    exif_extract -> document [label="metadata.exif" style=dashed]
    virus_scan -> document [label="metadata.virus" style=dashed]

    action -> linkage_parent [label="post_save hook" color="#27AE60"]
    document -> linkage_child [label="for each doc" color="#27AE60"]
    doc2 -> linkage_child2 [label="additional" color="#27AE60" style=dashed]

    group_id -> linkage_parent [style=dashed color="#888"]
    group_id -> linkage_child [style=dashed color="#888"]
    group_id -> linkage_child2 [style=dashed color="#888"]

    document -> access [label="on view" style=dashed]

    // ── Cross-references ──
    xref [label="See also:\n· Action (p.17)\n· Action Touches (p.19)\n· Document Library (p.22)" shape=note fillcolor="#F4ECF7" fontsize=8]
}
