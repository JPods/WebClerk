# Example local environment variables for Google Calendar OAuth
# Copy this file to .env and fill in values. .env is ignored by git.

# Primary Google Calendar credentials (used if Connection.config.env_prefix=GCAL_PRIMARY)
GCAL_PRIMARY_CLIENT_ID=
GCAL_PRIMARY_CLIENT_SECRET=
GCAL_PRIMARY_REDIRECT_URI=http://localhost:8000/sync/google/calendar/callback

# Optional: Sentry and Django basics
SECRET_KEY=change-me-for-local
DEBUG=True
DATABASE_NAME=commerce_expert
DATABASE_USER=postgres
DATABASE_PASS=
DATABASE_HOST=localhost
DATABASE_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
