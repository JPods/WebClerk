{
  "name": "WebClerk-react",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck:proposal": "tsc -p tsconfig.strict.proposal.json --pretty false",
    "typecheck:kanban": "tsc -p tsconfig.strict.kanban.json --pretty false",
    "typecheck:applypayments": "tsc -p tsconfig.strict.applypayments.json --pretty false",
    "sass": "sass ./src:./src/",
    "sass-min": "sass ./src:./src --style compressed",
    "generate:types": "cd ../webClerk3 && python manage.py generate_ts_types --out ../React2025/src/generated/modelTypes.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@pdfme/common": "^6.1.11",
    "@pdfme/generator": "^6.1.11",
    "@pdfme/schemas": "^6.1.11",
    "@pdfme/ui": "^6.1.11",
    "@phosphor-icons/react": "^2.1.10",
    "@reduxjs/toolkit": "^2.6.1",
    "@uiw/react-md-editor": "^4.1.1",
    "apexcharts": "^4.1.0",
    "axios": "^1.8.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.518.0",
    "react": "^19.2.3",
    "react-apexcharts": "^1.7.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.56.0",
    "react-icons": "^5.5.0",
    "react-international-phone": "^4.8.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.1.5",
    "react-router-dom": "^7.5.0",
    "sass": "^1.97.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@tailwindcss/postcss": "^4.0.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/gensync": "^1.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^4.0.8",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/core": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "@react-jvectormap/world": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  }
}
