    "/api/model-fields/": {
      "get": {
        "operationId": "core_model_fields_retrieve",
        "description": "Introspect Django models and return their concrete fields.",
        "parameters": [
          {
            "in": "query",
            "name": "app_name",
            "schema": {
              "type": "string"
            },
            "description": "Filter to a single app"
