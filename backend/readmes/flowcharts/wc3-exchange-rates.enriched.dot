// WC3 Exchange Rate Flow — Setting-based currency conversion
// All amounts stored in base currency. Rate applied at boundary.
// Regenerate: dot -Tpdf wc3-exchange-rates.dot -o wc3-exchange-rates.pdf

// CodeMap revision: 1 — 2026-08-11

digraph exchange_rates {
    size="7.5,10.0"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB

    // ─── Setting ───
    setting [label="Setting\npurpose='exchange_rates'\n\nbase_currency: USD\nrates: {EUR: 0.92, GBP: 0.79, ...}\nprecision_convert: 4\nprecision_display: 2" shape=note fillcolor="#e8f5e9"]

    // ─── Connection (optional) ───
    conn [label="Connection\n(exchange rate API)\n\nAuto-update rates\non customer schedule" shape=component fillcolor="#e3f2fd" style="filled,dashed"]

    // ─── Transaction flow ───
    subgraph cluster_transaction {
        label="Transaction Lifecycle"
        style=rounded
        color="#666"

        create [label="Order / Invoice\nCreated\n\nAll amounts in\nbase currency (USD)" shape=box fillcolor="#fff3e0"]
        capture [label="capture_rate()\n\nStamps on sell envelope:\nexchange_rate\nexchange_currency\nexchange_dt" shape=box fillcolor="#fff3e0"]
        display [label="Print / Share\nwith Trading Partner\n\nconvert(amount, 'EUR')\nusing captured rate" shape=box fillcolor="#e8eaf6"]
        payment [label="Payment\nReceived" shape=box fillcolor="#e8f5e9" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/payment.py" target="_blank" tooltip="Payment — handles AR (received) and AP (expense). Signed amounts. Category maps to GL. Statement Sorter feeds expense side.\nModel: apps/transactions/models/payment.py\nFunctions:
  Payment @ apps/transactions/models/payment.py:1 (AR+AP via type field; signed amounts)"]
        settle [label="settle_fx_difference()\n\nCaptured rate vs\ncurrent bank rate" shape=box fillcolor="#fce4ec"]
    }

    // ─── Outputs ───
    subgraph cluster_settlement {
        label="Settlement"
        style=rounded
        color="#666"

        no_diff [label="Rates unchanged\n\nNo action" shape=box fillcolor="#e8f5e9"]
        fx_gain [label="FX Gain\n\nBalancing Ledger\nsource='FX'" shape=box fillcolor="#c8e6c9"]
        fx_loss [label="FX Loss\n\nBalancing Ledger\nsource='FX'" shape=box fillcolor="#ffcdd2"]
        journal [label="Journalize\nFX Gain/Loss\nGL Account" shape=box fillcolor="#e8eaf6"]
    }

    // ─── Edges ───
    conn -> setting [label="set_rate()" style=dashed]
    setting -> capture [label="get_rate()"]

    create -> capture [label="foreign currency\ncustomer"]
    capture -> display
    display -> payment [label="customer pays"]
    payment -> settle

    settle -> no_diff [label="rates equal"]
    settle -> fx_gain [label="rate moved\nin our favor"]
    settle -> fx_loss [label="rate moved\nagainst us"]

    fx_gain -> journal
    fx_loss -> journal

    // ─── Manual update ───
    manual [label="Manual\nset_rate()" shape=ellipse fillcolor="#fff9c4"]
    manual -> setting
}
