    action [label="Action Record\n(Action model)\n\nconfig.escalation\nowner / sunset\nstatus tracking" shape=box fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/core/models/action.py:10" target="_blank" tooltip="Universal task — who, what, why, when, where, how. References any record. Tracks communication touches.\nModel: apps/core/models/action.py:10\nFunctions:
