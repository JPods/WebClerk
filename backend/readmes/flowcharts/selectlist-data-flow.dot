digraph selectlist_data_flow {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#f8f9fa", color="#dee2e6"];
    edge [fontname="Helvetica", fontsize=9, color="#6c757d"];

    // Title
    labelloc="t";
    label="Select List Data Flow\nconfig.selectlists.<field> = [{value, label}]";
    fontsize=14;

    // Data sources
    subgraph cluster_settings {
        label="Setting Records (PostgreSQL)";
        style="rounded,dashed";
        color="#adb5bd";
        fontsize=11;

        wc_model [label="wc-model-<model>\npurpose: wc:model\nparent_model: order|invoice|..." fillcolor="#d4edda"];
        company [label="company-profile\npurpose: wc:company_profile" fillcolor="#d4edda"];
        field_access [label="DEV-NNN\npurpose: wc:field_access\n(legacy)" fillcolor="#fff3cd"];
        ida114 [label="ida-114\npurpose: wc:admin\n(emptied 2026-08-18)" fillcolor="#f8d7da" fontcolor="#721c24"];
    }

    // Canonical path
    selectlists [label="config.selectlists.<field>\n[{value, label}]" shape=record fillcolor="#cce5ff" color="#004085" fontcolor="#004085"];

    // Legacy paths
    behaviors [label="config.behaviors.<field>.options\n(legacy — read as fallback)" fillcolor="#fff3cd" fontcolor="#856404"];
    field_behaviors [label="config.field_behaviors.<field>.options\n(legacy — read as fallback)" fillcolor="#fff3cd" fontcolor="#856404"];
    lists_choices [label="config.lists.<name>.choices\n(legacy DMS — emptied)" fillcolor="#f8d7da" fontcolor="#721c24"];

    // Backend scanner
    scanner [label="/wcapi/selectlists/\nSelectListCatalogView\nscans all Settings" shape=ellipse fillcolor="#e2d5f1" color="#6f42c1" fontcolor="#6f42c1"];

    // Frontend consumers
    subgraph cluster_frontend {
        label="React2025 Frontend";
        style="rounded,dashed";
        color="#adb5bd";
        fontsize=11;

        useDataBrowser [label="useDataBrowser.ts\nmerges selectlists\ninto fieldBehaviors" fillcolor="#d4edda"];
        selectListBrowser [label="SelectListBrowser.tsx\n/selectlists tool page\nedit + harmonize" fillcolor="#cce5ff"];
        dropdowns [label="Field Dropdowns\n<select> in detail panes\nDataBrowser + App mode" fillcolor="#d4edda"];
    }

    // Edges — canonical flow
    wc_model -> selectlists [label="canonical" color="#28a745" fontcolor="#28a745"];
    company -> selectlists [label="canonical" color="#28a745" fontcolor="#28a745"];

    // Edges — legacy fallback
    wc_model -> behaviors [label="legacy" style=dashed];
    field_access -> field_behaviors [label="legacy" style=dashed];
    ida114 -> lists_choices [label="emptied" style=dotted color="#dc3545"];

    // Scanner reads all paths
    selectlists -> scanner [label="primary"];
    behaviors -> scanner [label="fallback" style=dashed];
    field_behaviors -> scanner [label="fallback" style=dashed];
    lists_choices -> scanner [label="fallback" style=dashed];

    // Scanner feeds browser
    scanner -> selectListBrowser;

    // useDataBrowser reads Setting directly
    selectlists -> useDataBrowser [label="config.selectlists\nmerged into behaviors"];
    behaviors -> useDataBrowser [label="config.behaviors\n(existing)" style=dashed];

    // useDataBrowser feeds dropdowns
    useDataBrowser -> dropdowns [label="fieldBehaviors\ntype=select + options"];

    // Browser can save back
    selectListBrowser -> selectlists [label="save edits\nvia wcapi/save" style=dashed color="#007bff" fontcolor="#007bff"];
}
