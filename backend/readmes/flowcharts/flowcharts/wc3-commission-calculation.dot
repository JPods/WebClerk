// WC3 Commission Calculation — line-item controlled commissions
// From wc2 page 36: Rep % × Item commissionableness % → line commission
// Render: dot -Tpdf wc3-commission-calculation.dot -o wc3-commission-calculation.pdf

digraph wc3_commissions {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Commission Calculation\nLine-item controlled: rep rate × item commissionableness"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.8
    ranksep=0.8

    // ── Commission sources ──
    subgraph cluster_rates {
        label="Commission Rates"
        style="filled,rounded"
        fillcolor="#F0F4F8"
        color="#B0BEC5"
        fontsize=9
        fontcolor="#546E7A"

        rep [label="Rep Record\ncommission: 10%" fillcolor="#E8EAF6" color="#9FA8DA"]
        sales_emp [label="Sales Employee\ncommission: 5%" fillcolor="#E8EAF6" color="#9FA8DA"]
    }

    // ── Item factors ──
    subgraph cluster_items {
        label="Item Commissionableness"
        style="filled,rounded"
        fillcolor="#FFF8E1"
        color="#FFE082"
        fontsize=9
        fontcolor="#F57F17"

        item_abc [label="Item \"abc\"\ncommissionable: 80%\n(reduced — low margin)" fillcolor="#FFF9C4" color="#FFF176"]
        item_xyz [label="Item \"xyz\"\ncommissionable: 100%\n(full — special discount)" fillcolor="#FFF9C4" color="#FFF176"]
    }

    // ── Calculation ──
    calc [label="Line Commission\nCalculation" shape=octagon fillcolor="#C8E6C9"
          color="#81C784" fontsize=11]

    // ── Invoice result ──
    subgraph cluster_result {
        label="Invoice Result"
        style="filled,rounded"
        fillcolor="#F3E5F5"
        color="#CE93D8"
        fontsize=9
        fontcolor="#7B1FA2"

        line1 [label="Line: abc × $10\nSales: $10 × 5% × 80% = $0.40\nRep: $10 × 10% × 80% = $0.80"
               fillcolor="#E1BEE7" color="#BA68C8" fontsize=9]
        line2 [label="Line: xyz × $10\nSales: $10 × 5% × 100% = $0.50\nRep: $10 × 10% × 100% = $1.00"
               fillcolor="#E1BEE7" color="#BA68C8" fontsize=9]
    }

    invoice [label="Invoice Total\n$20.00 sales\n$2.70 commissions" fillcolor="#C8E6C9"
             color="#66BB6A" fontsize=11]

    // ── Edges ──
    rep -> calc [label="10%" color="#5C6BC0"]
    sales_emp -> calc [label="5%" color="#5C6BC0"]
    item_abc -> calc [label="80%" color="#FFB300"]
    item_xyz -> calc [label="100%" color="#FFB300"]

    calc -> line1 [color="#AB47BC"]
    calc -> line2 [color="#AB47BC"]
    line1 -> invoice [color="#66BB6A"]
    line2 -> invoice [color="#66BB6A"]
}
