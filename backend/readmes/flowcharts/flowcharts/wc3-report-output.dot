// WC3 Report Output — document routing to recipient
// From wc2 pages 15 (print routing) + 24 (communications channels)
// WC3: PDF/email/API/webhook replace FAX/EDI/4D
// Render: dot -Tpdf wc3-report-output.dot -o wc3-report-output.pdf

digraph wc3_report_output {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Report & Document Output\nHow documents reach their recipients"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── Trigger ──
    trigger [label="Print / Send\nDocument" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=11]

    // ── Report source ──
    report [label="Report Record\n(template + data)\n\nPrimary report\nor defined layout"
            fillcolor="#C5CAE9" color="#7986CB"]

    // ── Check output type ──
    check [label="Check\nOutput Type" shape=diamond fillcolor="#FFF9C4"
           color="#FFF176" fontsize=11]

    // ── Output channels ──
    subgraph cluster_outputs {
        label="Output Channels"
        style="filled,rounded"
        fillcolor="#F0F4F8"
        color="#B0BEC5"
        fontsize=9
        fontcolor="#546E7A"

        pdf [label="PDF\ngenerate & download\nor view in browser" fillcolor="#C8E6C9"
             color="#81C784"]
        email [label="Email\nsend with PDF\nattachment\n(Action record)" fillcolor="#BBDEFB"
               color="#64B5F6"]
        api [label="API / Webhook\nJSON payload to\nConnection endpoint" fillcolor="#FFE0B2"
             color="#FFB74D"]
        sync_bundle [label="Sync Bundle\nvia Connection model\n(replaces EDI)" fillcolor="#E1BEE7"
                     color="#BA68C8"]
        databrowser [label="databrowser\nexport / print\n(replaces QuickReport)" fillcolor="#B3E5FC"
                     color="#4FC3F7"]
    }

    // ── Communication record ──
    comm [label="Communication\nRecord\n\nwho, what, when\naudit trail" fillcolor="#F3E5F5"
          color="#CE93D8" fontsize=9]

    // ── Edges ──
    trigger -> report [color="#7986CB"]
    report -> check [color="#5C6BC0"]

    check -> pdf [label="PDF" color="#43A047"]
    check -> email [label="email" color="#1E88E5"]
    check -> api [label="API" color="#FF8F00"]
    check -> sync_bundle [label="sync" color="#8E24AA"]
    check -> databrowser [label="export" color="#00ACC1"]

    pdf -> comm [style=dashed color="#AB47BC"]
    email -> comm [style=dashed color="#AB47BC"]
    api -> comm [style=dashed color="#AB47BC"]
    sync_bundle -> comm [style=dashed color="#AB47BC"]
}
