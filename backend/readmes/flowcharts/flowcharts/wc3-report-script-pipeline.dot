// WC3 Report Script Pipeline — Before / During / After
// Three-phase execution: setup → per-record → completion
// Render: dot -Tpdf wc3-report-script-pipeline.dot -o wc3-report-script-pipeline.pdf

digraph wc3_report_script_pipeline {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Report Script Pipeline\nBefore (once) → During (per record) → After (once)"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── Trigger ──
    trigger [label="User Runs Report\n\nSelected records\nor filtered set" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=11]

    // ── Report record ──
    report [label="Report Record\n\nname · model_name\nscript_before\nscript_during\nscript_after" shape=parallelogram fillcolor="#C5CAE9" color="#7986CB"]

    // ── Access mode decision ──
    access_check [label="Records\nChanged?" shape=diamond fillcolor="#FFF9C4" color="#FFF176"]
    read_only [label="Access:\nREAD ONLY\n\nNo locks\nNo writes" fillcolor="#C8E6C9" color="#66BB6A" fontsize=9]
    read_write [label="Access:\nREAD-WRITE\n\nRecord locked\nfor update" fillcolor="#FFCDD2" color="#E57373" fontsize=9]

    // ── Phase 1: Before ──
    subgraph cluster_before {
        label="Phase 1 — script_before (runs ONCE)"
        style="filled,rounded"
        fillcolor="#E8F5E9"
        color="#A5D6A7"
        fontsize=9
        fontcolor="#2E7D32"

        before_init [label="Initialize\naccumulators\n(totals, counts)" fillcolor="#C8E6C9" color="#81C784" fontsize=9]
        before_filter [label="Apply filters\nestablish\nworking set" fillcolor="#C8E6C9" color="#81C784" fontsize=9]
        before_open [label="Open output\nstream / PDF /\nconnection" fillcolor="#C8E6C9" color="#81C784" fontsize=9]

        before_init -> before_filter -> before_open [color="#66BB6A"]
    }

    // ── Phase 2: During (loop) ──
    subgraph cluster_during {
        label="Phase 2 — script_during (per record)"
        style="filled,rounded"
        fillcolor="#E3F2FD"
        color="#90CAF9"
        fontsize=9
        fontcolor="#1565C0"

        load [label="Load\nRecord" fillcolor="#BBDEFB" color="#64B5F6" fontsize=9]
        process [label="Process\n\nCalculate\nAccumulate\nFormat" fillcolor="#BBDEFB" color="#64B5F6" fontsize=9]
        unload [label="UNLOAD\nRecord\n\n(free memory)" fillcolor="#BBDEFB" color="#42A5F5" fontsize=9 fontcolor="#0D47A1"]
        more [label="More\nRecords?" shape=diamond fillcolor="#E1F5FE" color="#4FC3F7" fontsize=9]

        load -> process -> unload -> more [color="#42A5F5"]
    }

    // ── Phase 3: After ──
    subgraph cluster_after {
        label="Phase 3 — script_after (runs ONCE)"
        style="filled,rounded"
        fillcolor="#FFF3E0"
        color="#FFCC80"
        fontsize=9
        fontcolor="#E65100"

        after_totals [label="Write totals\nsummary\nresults" fillcolor="#FFE0B2" color="#FFB74D" fontsize=9]
        after_format [label="Format\nfinal output" fillcolor="#FFE0B2" color="#FFB74D" fontsize=9]
        after_notify [label="Send notifications\nclose streams\nupdate records" fillcolor="#FFE0B2" color="#FFB74D" fontsize=9]

        after_totals -> after_format -> after_notify [color="#FF9800"]
    }

    // ── Output ──
    output [label="Output\n\nPrint · Email\nJSON · Export\nAPI · Label" fillcolor="#F3E5F5" color="#CE93D8" fontsize=10]

    // ── Built-in lock ──
    lock_note [label="Built-in reports:\nBefore + After locked\nDuring = user-editable"
               shape=note fillcolor="#FFFDE7" color="#FFF176" fontsize=8]

    // ── Edges ──
    trigger -> report [color="#7986CB"]
    report -> access_check [color="#5C6BC0"]
    access_check -> read_only [label="no" color="#43A047"]
    access_check -> read_write [label="yes" color="#E53935"]

    read_only -> before_init [color="#66BB6A"]
    read_write -> before_init [color="#E57373"]

    before_open -> load [color="#42A5F5" lhead=cluster_during]

    more -> load [label="yes" color="#42A5F5"]
    more -> after_totals [label="no" color="#FF9800"]

    after_notify -> output [color="#AB47BC"]

    report -> lock_note [style=dashed color="#FFF176" constraint=false]
}
