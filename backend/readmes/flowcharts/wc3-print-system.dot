// WC3 Print System — Report Selection, Rendering, and Editing
// Heritage: WC2 Defined Reports dialog + SuperReport + multi-destination output
// Render: dot -Tpdf wc3-print-system.dot -o wc3-print-system.pdf

digraph wc3_print {
    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 — Print System\nCmd+P = Primary | Print Button / Cmd+Opt+P = Report Selector"
    labelloc=t
    fontsize=14
    pad=0.5

    // ---- Entry Points ----
    subgraph cluster_entry {
        label="Entry Points"
        style=dashed
        color="#999999"

        cmd_p [label="Cmd+P\n(Print Primary)" shape=box fillcolor="#AED6F1"]
        print_btn [label="Print Button\nor Cmd+Opt+P" shape=box fillcolor="#AED6F1"]
        db_print [label="databrowser\nPrint Column" shape=box fillcolor="#AED6F1"]
    }

    // ---- Report Selector Dialog ----
    subgraph cluster_selector {
        label="Report Selector Dialog"
        style=filled
        fillcolor="#FEF9E7"
        color="#F4D03F"

        selector [label="Defined Reports\nfor this Model + User\n\nColumns:\nType | Name | Description\n\nSorted by sort_order" shape=box fillcolor="#F4D03F" fontsize=10]

        dbl_click [label="Double-click\nor Enter" shape=diamond fillcolor="#FDFEFE" fontsize=9]
        setup_btn [label="Report Setup\n(edit authority)" shape=box fillcolor="#E8DAEF"]
        new_btn [label="New Report\n(create authority)" shape=box fillcolor="#E8DAEF"]
    }

    // ---- Output Type Router ----
    subgraph cluster_router {
        label="Output Type Router"
        style=filled
        fillcolor="#EBF5FB"
        color="#3498DB"

        router [label="Route by\noutput_type" shape=diamond fillcolor="#85C1E9"]

        // Output types
        print_out [label="print\n(pdfme → PDF\nor browser print)" shape=box fillcolor="#82E0AA"]
        email_out [label="email\n(render PDF\n+ send via Alice)" shape=box fillcolor="#F5B7B1"]
        export_out [label="export\n(CSV/Tab/JSON\nto download)" shape=box fillcolor="#D5F5E3"]
        label_out [label="label\n(pdfme label\ntemplate)" shape=box fillcolor="#FADBD8"]
        list_out [label="list\n(databrowser\nfiltered view)" shape=box fillcolor="#D6EAF8"]
        letter_out [label="letter\n(pdfme letter\ntemplate)" shape=box fillcolor="#FCF3CF"]
        api_out [label="api / json\n(POST to endpoint\nor clipboard)" shape=box fillcolor="#D5D8DC"]
    }

    // ---- pdfme Rendering ----
    subgraph cluster_pdfme {
        label="pdfme Client-Side Rendering"
        style=filled
        fillcolor="#E8F8F5"
        color="#1ABC9C"

        load_template [label="Load pdfme Template\nfrom Report.config\n.pdfme_template" shape=box fillcolor="#A3E4D7"]
        populate [label="Populate Fields\nfrom Record Data\n(fieldRegistry.ts)" shape=box fillcolor="#A3E4D7"]
        generate [label="@pdfme/generator\ngenerate()" shape=box fillcolor="#76D7C4"]
    }

    // ---- Destination ----
    subgraph cluster_dest {
        label="Destination"
        style=filled
        fillcolor="#FDEDEC"
        color="#E74C3C"

        preview [label="Preview\n(in-browser)" shape=box fillcolor="#F5B7B1"]
        download [label="Download\n(.pdf file)" shape=box fillcolor="#F5B7B1"]
        printer [label="Send to\nPrinter" shape=box fillcolor="#F5B7B1"]
        email_send [label="Email\n(Alice)" shape=box fillcolor="#F5B7B1"]
        disk [label="Save to Disk\n(.csv/.txt/.json)" shape=box fillcolor="#F5B7B1"]
        clipboard [label="Clipboard" shape=box fillcolor="#F5B7B1"]
    }

    // ---- Report Editor (PdfDesigner) ----
    subgraph cluster_editor {
        label="Report Editor"
        style=filled
        fillcolor="#F4ECF7"
        color="#8E44AD"

        editor_router [label="Route by\ncategory" shape=diamond fillcolor="#D2B4DE"]
        pdf_designer [label="pdfme Designer\n(visual drag+drop)" shape=box fillcolor="#D7BDE2"]
        export_editor [label="Export Config\n(fields, delimiter,\nline ending)" shape=box fillcolor="#D7BDE2"]
        list_editor [label="List Config\n(databrowser layout\ncolumns, filters)" shape=box fillcolor="#D7BDE2"]
        letter_editor [label="Letter Editor\n(rich text +\nmail merge fields)" shape=box fillcolor="#D7BDE2"]
        email_editor [label="Email Template\n(subject, body,\nmerge fields)" shape=box fillcolor="#D7BDE2"]
        save_report [label="Save to\nReport Model" shape=box fillcolor="#82E0AA"]
    }

    // ---- Report Model ----
    report_model [label="Report Model\n\nname\nmodel_name\noutput_type\ncategory\nrole_required\nsort_order\nconfig {}\n  └ pdfme_template\n  └ fields\n  └ delimiter\n  └ endpoint_url" shape=note fillcolor="#FDFEFE" fontsize=9]

    // ---- Usage Tracking ----
    usage [label="Usage Tracking\n\nmetadata.flow:\n  use_count\n  last_used_utc\n  used_by[]" shape=note fillcolor="#FDFEFE" fontsize=9]

    // ---- Edges: Entry ----
    cmd_p -> router [label="primary report\nfor model" color="#3498DB"]
    print_btn -> selector [label="open dialog"]
    db_print -> selector [label="open dialog\nfor selected row"]

    // ---- Edges: Selector ----
    selector -> dbl_click
    selector -> setup_btn
    selector -> new_btn
    dbl_click -> router [label="selected report"]
    setup_btn -> editor_router [label="open for editing"]
    new_btn -> editor_router [label="blank report"]

    // ---- Edges: Router ----
    router -> print_out
    router -> email_out
    router -> export_out
    router -> label_out
    router -> list_out
    router -> letter_out
    router -> api_out

    // ---- Edges: Print/Label/Letter → pdfme ----
    print_out -> load_template
    label_out -> load_template
    letter_out -> load_template
    load_template -> populate -> generate

    // ---- Edges: pdfme → Destination ----
    generate -> preview
    generate -> download
    generate -> printer

    // ---- Edges: Other outputs → Destination ----
    email_out -> email_send
    export_out -> disk
    api_out -> clipboard
    api_out -> disk
    list_out -> preview [label="databrowser\nfiltered" style=dashed]

    // ---- Edges: Editor Router ----
    editor_router -> pdf_designer [label="report\nstatement\nlabel"]
    editor_router -> export_editor [label="export"]
    editor_router -> list_editor [label="list\nsummary"]
    editor_router -> letter_editor [label="letter"]
    editor_router -> email_editor [label="email"]
    pdf_designer -> save_report
    export_editor -> save_report
    list_editor -> save_report
    letter_editor -> save_report
    email_editor -> save_report
    save_report -> report_model

    // ---- Edges: Model feeds selector ----
    report_model -> selector [label="filtered by\nmodel_name\n+ user role" style=dashed color="#999999"]
    router -> usage [label="track\nusage" style=dashed color="#999999"]
}
