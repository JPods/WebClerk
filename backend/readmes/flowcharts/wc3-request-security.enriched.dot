// WC3 Request Security Pipeline — JSON-by-default, WriteGate, Demo Read-Only
// Three middleware layers controlling what gets in and what format it speaks
// Render: dot -Tpdf wc3-request-security.dot -o wc3-request-security.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_request_security {
    size="7.5,10.0"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — Request Security Pipeline\nJSON-by-default · WriteGate · Demo Read-Only\nThree layers before any view executes"
    labelloc=t

    // ── Incoming Request ──
    request [label="Incoming HTTP\nRequest\n\nmethod, path\nheaders, body" shape=box fillcolor="#D4E6F1" penwidth=2]

    // ── Layer 1: Demo Read-Only ──
    subgraph cluster_demo {
        label="Layer 1: Demo Read-Only Mode\nDEMO_READ_ONLY=True → blocks ALL writes, no exemptions"
        style=filled fillcolor="#FADBD8" color="#F5B7B1"

        demo_check [label="DEMO_READ_ONLY\nenabled?" shape=diamond fillcolor="#FDFEFE" fontsize=8]
        demo_block [label="405 Method\nNot Allowed\n\n'This is a read-only demo.\nDownload WebClerk at\nwebclerk.com to modify data.'" shape=box fillcolor="#F5B7B1" fontsize=8]
        demo_pass [label="Not demo\nor GET/HEAD\n→ continue" shape=box fillcolor="#D5F5E3" fontsize=8]
    }

    // ── Layer 2: WriteGate ──
    subgraph cluster_writegate {
        label="Layer 2: WriteGate Middleware\nWRITE_GATE_ENABLED=True → allow-listed paths only for POST/PUT/PATCH/DELETE"
        style=filled fillcolor="#FCF3CF" color="#F9E79F"

        wg_method [label="Write method?\nPOST PUT PATCH\nDELETE" shape=diamond fillcolor="#FDFEFE" fontsize=8]
        wg_exact [label="Exact path match?\n/wcapi/save\n/wcapi/query\n/wcapi/delete" shape=diamond fillcolor="#FDFEFE" fontsize=8]
        wg_prefix [label="Prefix match?\n/wcapi/*\n/api/auth/*\n/api/token/*\n/admin/*" shape=diamond fillcolor="#FDFEFE" fontsize=8]
        wg_regex [label="Regex match?\n/<model>/<id>\n/<model>" shape=diamond fillcolor="#FDFEFE" fontsize=8]
        wg_block [label="405 WriteGate:\npath not allowed" shape=box fillcolor="#F5B7B1" fontsize=8]
        wg_pass [label="Path allowed\n→ continue" shape=box fillcolor="#D5F5E3" fontsize=8]
    }

    // ── Layer 3: JSON-by-Default ──
    subgraph cluster_json {
        label="Layer 3: JSON-by-Default\nAPI_JSON_DEFAULT=True → all responses are JSON unless path is HTML-exempt"
        style=filled fillcolor="#E8DAEF" color="#D2B4DE"

        json_check [label="HTML-exempt\npath?" shape=diamond fillcolor="#FDFEFE" fontsize=8]
        json_exempt [label="HTML Exempt Paths\n\n/admin/\n/admin-django/\n/static/\n/media/\n/api/swagger/\n/api/schema/\n/api/redoc/\n\n+ exact: / /about/\n+ prefix: /manage/" shape=box fillcolor="#FDFEFE" fontsize=8]
        json_html [label="Serve HTML\n(template page)" shape=box fillcolor="#EBF5FB" fontsize=8]
        json_api [label="Serve JSON\n(API response)\n\nErrors → JSON\nExceptions → JSON\n404/500 → JSON" shape=box fillcolor="#D5F5E3" fontsize=8]
    }

    // ── View Layer ──
    subgraph cluster_view {
        label="View Layer (DRF + wcapi)"
        style=filled fillcolor="#D5F5E3" color="#82E0AA"

        auth [label="DRF Auth\n\nJWT / Session\nRBAC check\nfield_access" shape=box fillcolor="#FDFEFE" fontsize=8]
        view [label="View executes\n\nwcapi CRUD\nSync receive\nUpload\nCustom views" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ── Config ──
    subgraph cluster_config {
        label="Configuration (settings.py)"
        style=filled fillcolor="#EBF5FB" color="#AED6F1"

        cfg [label="DEMO_READ_ONLY = env var\nWRITE_GATE_ENABLED = True\nAPI_JSON_DEFAULT = True\n\nWRITE_GATE_EXACT_PATHS\nWRITE_GATE_PREFIXES\nWRITE_GATE_ALLOWED_REGEX\nHTML_EXEMPT_PATH_PREFIXES" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ═══ EDGES ═══

    // Request → Demo check
    request -> demo_check

    // Demo layer
    demo_check -> demo_block [label="yes + write\nmethod"]
    demo_check -> demo_pass [label="no or\nGET/HEAD"]

    // Demo → WriteGate
    demo_pass -> wg_method

    // WriteGate layer
    wg_method -> wg_exact [label="yes"]
    wg_method -> json_check [label="no (GET/HEAD)\nskip gate"]
    wg_exact -> wg_pass [label="match"]
    wg_exact -> wg_prefix [label="no match"]
    wg_prefix -> wg_pass [label="match"]
    wg_prefix -> wg_regex [label="no match"]
    wg_regex -> wg_pass [label="match"]
    wg_regex -> wg_block [label="no match"]

    // WriteGate → JSON layer
    wg_pass -> json_check

    // JSON layer
    json_check -> json_exempt [label="check\nexemptions"]
    json_exempt -> json_html [label="exempt"]
    json_exempt -> json_api [label="not exempt"]

    // JSON → View
    json_html -> auth
    json_api -> auth
    auth -> view

    // Config feeds all layers
    cfg -> demo_check [style=dashed]
    cfg -> wg_method [style=dashed]
    cfg -> json_check [style=dashed]
}
