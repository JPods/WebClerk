[Unit]
Description=WebClerk3 Celery Beat Scheduler
After=network.target redis.service

[Service]
Type=simple
User=webclerk
Group=webclerk
WorkingDirectory=/srv/webclerk3
EnvironmentFile=/srv/webclerk3/.env

ExecStart=/srv/webclerk3/bin/celery \
    -A webclerk3_api \
    beat \
    --loglevel=info \
    --logfile=/var/log/webclerk3/celery-beat.log \
    --pidfile=/var/run/webclerk3/celerybeat.pid \
    --schedule=/var/run/webclerk3/celerybeat-schedule

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
