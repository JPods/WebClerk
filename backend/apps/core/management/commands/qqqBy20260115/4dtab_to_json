import csv
import json
from pathlib import Path

base = Path("/Users/williamjames/Documents/CommerceExpert/webclerk3_data")
in_path = base / "wc2_detailFieldList_by_table.txt"
out_path = base / "wc2_detailFieldList_by_table.json"

tables = {}

with in_path.open("r", encoding="utf-8", newline="") as f:
    reader = csv.reader(f, delimiter="\t")
    header = next(reader)  # ['table field', 'Type', 'Length', 'Indexed', 'Unique']
    for row in reader:
        if not row or len(row) < 5:
            continue
        table_name = row[0].strip()
        field_name = row[1].strip()
        field_type = row[2].strip()
        length = row[3].strip()
        indexed = row[4].strip() if len(row) > 4 else ""
        unique = row[5].strip() if len(row) > 5 else ""

        if not table_name:
            continue

        tables.setdefault(table_name, []).append({
            "field": field_name,
            "type": field_type,
            "length": int(length) if length.isdigit() else length,
            "indexed": bool(indexed),
            "unique": bool(unique),
        })

with out_path.open("w", encoding="utf-8") as f:
    json.dump(tables, f, indent=2, ensure_ascii=False)

print("Wrote", out_path)
