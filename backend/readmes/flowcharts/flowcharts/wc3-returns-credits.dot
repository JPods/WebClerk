// WC3 Returns & Credits — RMA through credit memo to GL reversal
// Invoice (credit_note type) → reverse inventory → GL → erosion
// Render: dot -Tpdf wc3-returns-credits.dot -o wc3-returns-credits.pdf

digraph wc3_returns {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Returns & Credits\nRMA → credit memo → inventory reversal → GL"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── Return trigger ──
    customer [label="Customer\nreturns goods" fillcolor="#E8EAF6" color="#9FA8DA"]

    // ── Service/RMA ──
    service [label="Service Record\n(Action model)\n\nRMA number\nreason code\napproval" fillcolor="#FFE0B2" color="#FFB74D" fontsize=10]

    // ── Original invoice ──
    orig_invoice [label="Original Invoice\n(invoices)\n\nreference for\ncredit memo" fillcolor="#C5CAE9" color="#7986CB" fontsize=9]

    // ── Credit memo ──
    credit [label="Credit Memo\n(invoices)\n\ninvoice_type: credit_note\nnegative amounts\nrefs → original invoice" fillcolor="#FFCDD2" color="#EF9A9A" fontsize=11]

    credit_line [label="Credit Line\n(invoice_lines)\n\nnegative quantity\noriginal price\nitem_id" fillcolor="#FFCDD2" color="#EF9A9A"]

    // ── Inventory reversal ──
    inv_reversal [label="Inventory Reversal\n\non_hand += qty (returned)\non_so: no change\n\nPendingInventory\nAdjustment posted" fillcolor="#C8E6C9" color="#81C784"]

    // ── Serial status ──
    serial [label="Serial Status\n\nstatus: returned\nor: available\n(if restockable)\n\nSerialLog entry" fillcolor="#BBDEFB" color="#64B5F6" fontsize=9]

    // ── Inspection ──
    qa [label="QA Inspection\n(qas)\n\nrestockable?\ndamaged?\ndefective?\n\ndetermines disposition" shape=diamond fillcolor="#FFF9C4" color="#FFF176"]

    restock [label="Restock\nback to available\ninventory" fillcolor="#C8E6C9" color="#81C784" fontsize=9]
    scrap [label="Scrap / Dispose\nwrite off\nadjustment" fillcolor="#FFCDD2" color="#EF9A9A" fontsize=9]
    vendor_return [label="Return to Vendor\n(RTV)\nnew PO credit" fillcolor="#E1BEE7" color="#BA68C8" fontsize=9]

    // ── GL ──
    gl [label="GL Journals\n\nReverse sales journal\nCredit: Revenue (4000)\nDebit: AR (1200)\n\nInventory adjustment\nif restocked" fillcolor="#C8E6C9" color="#43A047"]

    // ── Ledger ──
    ledger [label="Ledger\n(AR schedule)\n\nbalance reduced\nby credit amount" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]

    // ── Erosion ──
    erosion [label="Erosion Detection\n(erosion table)\n\nreturn rate by item\nreturn rate by customer\ncost of returns" fillcolor="#E1BEE7" color="#CE93D8" fontsize=9]

    // ── Alice ──
    alice [label="Alice\nreturn patterns\nrepeat offenders\nproduct quality flags" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]

    // ── Edges ──
    customer -> service [label="request\nreturn" color="#7986CB"]
    service -> orig_invoice [label="reference" style=dashed color="#90A4AE"]
    service -> credit [label="approved →\ncreate credit" color="#E57373" style=bold]
    orig_invoice -> credit [label="copy lines\nnegate amounts" style=dashed color="#7986CB"]

    credit -> credit_line [color="#E57373"]
    credit_line -> inv_reversal [label="return to\ninventory" color="#66BB6A"]
    credit_line -> serial [label="if serialized" style=dashed color="#42A5F5"]

    inv_reversal -> qa [color="#FFB300"]
    qa -> restock [label="good" color="#43A047"]
    qa -> scrap [label="damaged" color="#E53935"]
    qa -> vendor_return [label="defective" color="#8E24AA"]

    credit -> gl [label="post\nreversal" color="#43A047"]
    credit -> ledger [label="reduce\nAR balance" color="#29B6F6"]

    credit -> erosion [label="track" style=dashed color="#AB47BC"]
    erosion -> alice [style=dashed color="#29B6F6"]
}
