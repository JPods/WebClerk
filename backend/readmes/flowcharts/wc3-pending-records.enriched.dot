// WC3 Pending Records — Intent Capture, Pattern Analysis, External Archive
// Every exchange of inventory and cash logged as intent → action → archive → insight
// Render: dot -Tpdf wc3-pending-records.dot -o wc3-pending-records.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_pending {
    size="10.0,7.5"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — Pending Records: Intent → Action → Archive → Insight\nEvery exchange of inventory and cash captured\nNoise stays outside · Patterns stay forever"
    labelloc=t

    // ── Business Events ──
    subgraph cluster_events {
        label="Business Events (Intent)"
        style=filled fillcolor="#EBF5FB" color="#AED6F1"

        receive [label="Receive\nGoods" shape=box fillcolor="#FDFEFE" fontsize=8]
        ship [label="Ship\nOrder" shape=box fillcolor="#FDFEFE" fontsize=8]
        adjust [label="Count\nAdjust" shape=box fillcolor="#FDFEFE" fontsize=8]
        transfer [label="Warehouse\nTransfer" shape=box fillcolor="#FDFEFE" fontsize=8]
        bom_consume [label="BOM\nConsumption" shape=box fillcolor="#FDFEFE" fontsize=8]
        payment_in [label="Customer\nPayment" shape=box fillcolor="#FDFEFE" fontsize=8]
        payment_out [label="Vendor\nPayment" shape=box fillcolor="#FDFEFE" fontsize=8]
        apply_cash [label="Apply to\nInvoice" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ── Pending Records (operational DB) ──
    subgraph cluster_pending {
        label="Pending Records — Operational Database\n(intent captured before action)"
        style=filled fillcolor="#FCF3CF" color="#F9E79F"

        pend_inv [label="PendingInventory\nAdjustment\n\nitem → layer\nqty, state\nreason, request_ref\ndt_applied\n\npending → applied\n         → canceled" shape=box fillcolor="#FDFEFE" fontsize=8]

        pend_pay [label="PendingPayment\nApplication\n\npayment → invoice\namount, state\nreason, request_ref\ndt_applied\n\npending → applied\n         → canceled" shape=box fillcolor="#FDFEFE" fontsize=8]

        pend_generic [label="Pending\n(Generic Queue)\n\nmodel_name, record_id\nname, purpose\nconfig (JSONField)\ndt_processed\nsequence, attempts" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ── Processing ──
    subgraph cluster_processing {
        label="Celery Workers — Process Intent"
        style=filled fillcolor="#D5F5E3" color="#82E0AA"

        inv_drain [label="Inventory Drain\nevery 30s\nadaptive delay\n\napply qty → layer\ncreate movement\nupdate Item.quantity" shape=box fillcolor="#FDFEFE" fontsize=8]
        pay_apply [label="Payment Apply\n\napply amount\nupdate invoice balance\ncreate ledger entry" shape=box fillcolor="#FDFEFE" fontsize=8]
        generic_proc [label="Generic Processor\n\nmodel-specific logic\nset dt_processed" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ── Committed Records ──
    subgraph cluster_committed {
        label="Committed Records (operational DB)"
        style=filled fillcolor="#D4E6F1" color="#AED6F1"

        inv_movement [label="InventoryMovement\n\nqty, movement_type\ndt_recorded\nreference (audit)" shape=box fillcolor="#FDFEFE" fontsize=8]
        pay_app [label="PaymentApplication\n\namount, applied_at\nnotes (audit)" shape=box fillcolor="#FDFEFE" fontsize=8]
        ledger [label="Ledger Entry\n\nvalue, dt_posted\ngl_account\nis_settled" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ── Archive (external storage) ──
    subgraph cluster_archive {
        label="External Archive — Dated Storage\n(noise leaves operational DB)"
        style=filled fillcolor="#E8DAEF" color="#D2B4DE"

        archive_task [label="Alice: Archive\nPending Task\n(Celery nightly)\n\nstate=applied/canceled\n→ extract intent data\n→ write dated file\n→ soft-delete from DB" shape=box fillcolor="#FDFEFE" fontsize=8]

        subgraph cluster_folders {
            label="Folder Structure"
            style=filled fillcolor="#F5EEF8" color="#D2B4DE"

            inv_folder [label="inventory/\n  {product_class}/\n    YYYY-MM.jsonl.gz\n\nqty, item, warehouse\nreason, dt, duration\nconversion_rate" shape=box fillcolor="#FDFEFE" fontsize=7]
            cash_folder [label="cash_flow/\n  {category}/\n    YYYY-MM.jsonl.gz\n\namount, payment, invoice\nterms, dt, aging_days\ndays_to_apply" shape=box fillcolor="#FDFEFE" fontsize=7]
            queue_folder [label="queue/\n  {model_name}/\n    YYYY-MM.jsonl.gz\n\nconfig, attempts\ndt_created, dt_processed\nprocessing_time" shape=box fillcolor="#FDFEFE" fontsize=7]
        }
    }

    // ── Analysis Collections ──
    subgraph cluster_analysis {
        label="Pattern Analysis — Load from Archive"
        style=filled fillcolor="#FADBD8" color="#F5B7B1"

        trends [label="Trend Analysis\n\ndemand slope\nsupply slope\ncash flow direction\nby product class\nby period" shape=box fillcolor="#FDFEFE" fontsize=8]
        cycles [label="Cycle Detection\n\nseasonal patterns\nweekly rhythms\nmonthly peaks\nQ4 concentration\nQ1 cash crunch" shape=box fillcolor="#FDFEFE" fontsize=8]
        volatility [label="Volatility\nMeasurement\n\nCV by product class\ndemand std dev\ncash flow variance\nleads adaptive\nwindow (n)" shape=box fillcolor="#FDFEFE" fontsize=8]
        process [label="Process Health\n\npending→applied rate\navg processing time\ncancellation patterns\nstale record alerts\nbottleneck detection" shape=box fillcolor="#FDFEFE" fontsize=8]
        forecast [label="Forecasting\n\ninventory_min/max\ncash flow projection\nreorder timing\npayment scheduling\nseasonal prep" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // ── Feedback to Operations ──
    feedback [label="Feedback to\nOperations\n\ninventory_min/max\ncash reserves target\nstaffing signals\npurchase timing\ncollection priority" shape=box fillcolor="#ABEBC6"]

    // ═══ EDGES ═══

    // Events → Pending
    receive -> pend_inv
    ship -> pend_inv
    adjust -> pend_inv
    transfer -> pend_inv
    bom_consume -> pend_inv
    payment_in -> pend_pay
    payment_out -> pend_pay
    apply_cash -> pend_pay

    // Pending → Processing
    pend_inv -> inv_drain
    pend_pay -> pay_apply
    pend_generic -> generic_proc

    // Processing → Committed
    inv_drain -> inv_movement
    pay_apply -> pay_app
    pay_apply -> ledger
    inv_drain -> pend_inv [label="state=applied" style=dashed]
    pay_apply -> pend_pay [label="state=applied" style=dashed]

    // Applied pending → Archive
    pend_inv -> archive_task [label="applied/canceled\n(nightly)" style=dashed]
    pend_pay -> archive_task [label="applied/canceled\n(nightly)" style=dashed]
    pend_generic -> archive_task [label="processed\n(nightly)" style=dashed]

    // Archive → Folders
    archive_task -> inv_folder
    archive_task -> cash_folder
    archive_task -> queue_folder

    // Folders → Analysis
    inv_folder -> trends
    inv_folder -> cycles
    inv_folder -> volatility
    cash_folder -> trends
    cash_folder -> cycles
    cash_folder -> forecast
    queue_folder -> process

    // Analysis cross-feeds
    volatility -> forecast [style=dashed label="adaptive n"]
    cycles -> forecast [style=dashed label="seasonal\nadjustment"]
    process -> trends [style=dashed label="bottleneck\ncorrection"]

    // Analysis → Feedback
    trends -> feedback
    cycles -> feedback
    volatility -> feedback
    forecast -> feedback
    process -> feedback

    // Feedback → Operations
    feedback -> pend_inv [label="inventory_min/max\nreorder timing" style=dashed color=blue]
    feedback -> pend_pay [label="cash reserves\ncollection priority" style=dashed color=blue]

    // ── Cross-references ──
    xref [label="See also:\n· Big4 Transactions (p.12)\n· Order to Invoice (p.10)\n· Payment GL (p.13)\n· Flight Sim Lifecycle (p.38)" shape=note fillcolor="#F4ECF7" fontsize=8]
}
