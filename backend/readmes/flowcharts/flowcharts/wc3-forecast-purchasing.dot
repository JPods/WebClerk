// WC3 Forecast & Purchasing — replenishment loop
// From wc2 pages 5-6: Forecast → Low Item by Vendor → PO → Inship
// Render: dot -Tpdf wc3-forecast-purchasing.dot -o wc3-forecast-purchasing.pdf

digraph wc3_forecast_purchasing {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Forecast & Purchasing\nReplenishment loop: demand signals → forecast → purchase → receive"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.7
    ranksep=0.8

    // ── Demand signals ──
    subgraph cluster_demand {
        label="Demand Signals"
        style="filled,rounded"
        fillcolor="#F0F4F8"
        color="#B0BEC5"
        fontsize=9
        fontcolor="#546E7A"

        proposals [label="Proposals\n(qty × probability)" fillcolor="#E8EAF6"]
        usage [label="Usage History\n(invoice line history)" fillcolor="#E8EAF6"]
        min_qty [label="Item Min Qty\n(reorder point)" fillcolor="#E8EAF6"]
        orders [label="Sales Orders\n(committed demand)" fillcolor="#E8EAF6"]
    }

    // ── Forecast engine ──
    forecast [label="Forecast\nEngine" shape=octagon fillcolor="#C5CAE9"
             color="#7986CB" fontsize=11]

    // ── Purchasing ──
    low_item [label="Low Item\nby Vendor" shape=octagon fillcolor="#BBDEFB"
             color="#64B5F6"]

    po [label="Purchase\nOrder" fillcolor="#E3F2FD" color="#90CAF9"]

    // ── Receiving ──
    inship [label="Receive Goods\n(Inship)" shape=octagon fillcolor="#C8E6C9"
            color="#81C784"]

    backorder [label="Maintain\nBackorders" fillcolor="#FFF9C4" color="#FFF176"]

    // ── Inventory effect ──
    inv_layer [label="Inventory Layer\ncreated per receipt\nqty + cost" fillcolor="#E1BEE7"
               color="#CE93D8" fontsize=9]

    item [label="Item Record\non_po -= qty\non_hand += qty" fillcolor="#E1BEE7"
          color="#CE93D8" fontsize=9]

    // ── Alice ──
    alice [label="Alice\npattern watch" fillcolor="#B3E5FC" color="#4FC3F7"
           fontsize=9 shape=box]

    // ── Edges ──
    proposals -> forecast [color="#7986CB"]
    usage -> forecast [color="#7986CB"]
    min_qty -> forecast [color="#7986CB"]
    orders -> forecast [color="#7986CB"]

    forecast -> low_item [label="items below\nreorder point" color="#5C6BC0"]

    low_item -> po [label="generate PO\nper vendor" color="#42A5F5"]
    orders -> po [label="direct\norder-to-PO" style=dashed color="#90A4AE"]

    po -> inship [label="vendor ships"]
    po -> backorder [label="partial\nshipment" style=dashed color="#FBC02D"]
    backorder -> po [style=dashed color="#FBC02D"]

    inship -> inv_layer [label="create layer\nper receipt" color="#66BB6A"]
    inv_layer -> item [color="#AB47BC"]

    forecast -> alice [label="anomaly\ndetection" style=dashed color="#29B6F6"]
    alice -> forecast [label="pattern\nalerts" style=dashed color="#29B6F6"]
}
