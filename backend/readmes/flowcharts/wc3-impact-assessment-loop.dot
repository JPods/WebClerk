// Impact Assessment Loop — Alice auto-populate + user correction cycle
// Render: dot -Tpdf wc3-impact-assessment-loop.dot -o wc3-impact-assessment-loop.pdf

digraph impact_loop {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled];
    edge [fontname="Helvetica", fontsize=9];

    labelloc="t";
    label="Impact Assessment Loop\nAlice guesses → User corrects → Alice learns → Admin time drops";
    fontsize=14;

    // User actions
    create [label="User creates\nselling action", shape=box, fillcolor="#e3f2fd"];
    predict [label="User sets\nimpact.predicted\n(2 seconds, gut feel)", shape=box, fillcolor="#bbdefb"];

    // Time passes
    time [label="Time passes\nCustomer buys\nor doesn't", shape=ellipse, fillcolor="#f5f5f5", fontcolor=gray40];

    // Alice scans
    scan [label="Alice scans\nlinked transactions\n(periodic task)", shape=box, fillcolor="#fff3e0"];
    fill [label="Alice auto-fills\nimpact.actual\n+ refs.transactions", shape=box, fillcolor="#ffe0b2"];

    // User reviews
    review [label="User reviews\nAlice's guess", shape=diamond, fillcolor="#e8f5e9"];
    confirm [label="Confirm\n(0 seconds)", shape=box, fillcolor="#c8e6c9"];
    correct [label="Correct + explain\n(2 seconds)", shape=box, fillcolor="#ffcdd2"];

    // Alice learns
    learn [label="Alice learns\nfrom corrections", shape=box, fillcolor="#fff3e0"];
    calibrate [label="Calibration\nimproves", shape=box, fillcolor="#ffe0b2"];

    // Metrics
    metrics [label="correction_rate\n40% → 10% → 2%\n(trust builds)", shape=note, fillcolor="#f3e5f5"];
    gap [label="avg_gap\n+ = over-optimistic\n- = under-estimating\n0 = calibrated", shape=note, fillcolor="#f3e5f5"];

    // Flow
    create -> predict;
    predict -> time;
    time -> scan;
    scan -> fill;
    fill -> review;
    review -> confirm [label="Agree"];
    review -> correct [label="Disagree"];
    confirm -> learn [label="positive signal\n(calibration correct)"];
    correct -> learn [label="correction signal\n(calibration off)"];
    learn -> calibrate;
    calibrate -> scan [label="next cycle\nbetter guess", style=dashed];

    // Metrics
    learn -> metrics [style=dotted];
    learn -> gap [style=dotted];
}
