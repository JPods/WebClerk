// WC3 refs.links and LinkageEntry — the "travel with" pattern
// Render: dot -Tpdf wc3-refs-linkage.dot -o wc3-refs-linkage.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_refs_linkage {
    size="7.5,10.0"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — refs.links and LinkageEntry\nConnecting Records Without Managing Individual FKs"
    labelloc=t

    // --- Transaction flow (left column) ---
    proposal [label="Proposal\n(header + lines)" shape=box fillcolor="#E8DAEF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/proposal.py" target="_blank" tooltip="Sales proposal — forecast. on_p tracks weighted probability.\nModel: apps/transactions/models/proposal.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (converts proposal to order)\nPending deltas: on_p: +qty_x_prob"]
    order [label="Order\n(header + lines)" shape=box fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/order.py" target="_blank" tooltip="Sales order — customer commitment. Creates +on_so and -on_p pending records.\nModel: apps/transactions/models/order.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (creates order from proposal)
  _create_transfer_pending_records @ apps/transactions/services/proposal_to_order.py:131 (pending records for +on_so, -on_p)\nPending deltas: on_so: +qty, on_p: -qty"]
    invoice [label="Invoice\n(header + lines)" shape=box fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/invoice.py" target="_blank" tooltip="Invoice — shipment event. Financial event triggers GL and inventory movement.\nModel: apps/transactions/models/invoice.py\nFunctions:
  transfer_order_to_invoice @ apps/transactions/services/order_to_invoice.py:16 (creates invoice from order)
  Pending.objects.create @ apps/transactions/services/order_to_invoice.py:332 (-on_hand, -on_so, +on_in)\nPending deltas: on_hand: -qty, on_so: -qty, on_in: +qty\nGL: AR debit, Revenue credit, Tax credit, COGS debit, Inventory credit, Commission"]

    // --- Conversion process ---
    convert_po [label="Convert\nProposal → Order" shape=octagon fillcolor="#F5CBA7"]
    convert_oi [label="Convert\nOrder → Invoice" shape=octagon fillcolor="#F5CBA7"]

    // --- refs.links on each record ---
    subgraph cluster_refs {
        label="refs.links (JSON cache on every record)"
        style=filled fillcolor="#FDFEFE" color="#AEB6BF"

        refs_links [label="refs.links\n\nlinks.customer = [{id, name, email, ...}]\nlinks.vendor = [{id, name, ...}]\nlinks.document = [{id, name, type}]\nlinks.linkage = [group_id]" shape=box fillcolor="#D4E6F1"]
        fk [label="FK Fields\n(source of truth)\n\ncustomer_id\nvendor_id\ncontact_id" shape=box fillcolor="#FCF3CF"]
        denorm [label="denormalize_org_links()\n(async via Celery)" shape=octagon fillcolor="#F5CBA7"]

        fk -> denorm [label="read FK"]
        denorm -> refs_links [label="snapshot\nfields"]
    }

    // --- LinkageEntry group ---
    subgraph cluster_linkage {
        label="LinkageEntry Group (group_id = 3001)"
        style=filled fillcolor="#D5F5E3" color="#82E0AA"

        le_order [label="order #450\nrole: source\nseq: 0" shape=box fillcolor="#FCF3CF"]
        le_spec [label="document #201\nrole: spec\nseq: 1" shape=box fillcolor="#FDFEFE"]
        le_qa [label="document #202\nrole: qa\nseq: 2" shape=box fillcolor="#FDFEFE"]
        le_video [label="document #203\nrole: video\nseq: 3" shape=box fillcolor="#FDFEFE"]
        le_cert [label="document #210\nrole: cert\nseq: 4" shape=box fillcolor="#FDFEFE"]
        le_item [label="item #55\nrole: item\nseq: 5" shape=box fillcolor="#FDFEFE"]
    }

    // --- Related content (right column) ---
    subgraph cluster_content {
        label="Related Content (travels with transaction)"
        style=filled fillcolor="#FDEBD0" color="#E59866"

        doc_spec [label="Spec Sheet\nspec-sheet.pdf" shape=note fillcolor="#FDFEFE"]
        doc_qa [label="QA Report\ninspection-042.pdf" shape=note fillcolor="#FDFEFE"]
        doc_video [label="Install Video\ninstall-guide.mp4" shape=note fillcolor="#FDFEFE"]
        doc_cert [label="Certification\nul-cert-2026.pdf" shape=note fillcolor="#FDFEFE"]
    }

    // --- Deep copy at line level ---
    deep_copy [label="Deep Copy\nrefs at line level\n\nrefs.links.linkage = [3001]\nrefs.source.converted_from = line_id" shape=box fillcolor="#D4E6F1"]

    // --- Alice ---
    alice [label="Alice\n\nrefs integrity audit\norphan detection\npattern recognition" shape=box fillcolor="#AED6F1"]

    // --- DENORM_REGISTRY ---
    registry [label="DENORM_REGISTRY\n\nSingle source of truth\nfor snapshot fields\nper model bucket" shape=note fillcolor="#F2F3F4"]

    // --- Edges: Transaction flow ---
    proposal -> convert_po
    convert_po -> order
    order -> convert_oi
    convert_oi -> invoice

    // --- Edges: Conversion deep copy ---
    convert_po -> deep_copy [label="line refs\ndeep-copied" style=dashed]
    convert_oi -> deep_copy [label="line refs\ndeep-copied" style=dashed]

    // --- Edges: Linkage pointer preserved ---
    deep_copy -> refs_links [label="linkage pointer\npreserved"]

    // --- Edges: refs.links points to linkage group ---
    refs_links -> le_order [label="refs.links.linkage\n= [3001]" style=dashed]

    // --- Edges: Linkage group members ---
    le_order -> le_spec [style=invis]
    le_spec -> le_qa [style=invis]
    le_qa -> le_video [style=invis]
    le_video -> le_cert [style=invis]
    le_cert -> le_item [style=invis]

    // --- Edges: Linkage entries point to actual content ---
    le_spec -> doc_spec [style=dashed]
    le_qa -> doc_qa [style=dashed]
    le_video -> doc_video [style=dashed]
    le_cert -> doc_cert [style=dashed]

    // --- Edges: Alice monitors ---
    refs_links -> alice [label="FK vs refs\nmismatch?" style=dashed]
    le_order -> alice [label="orphaned\ngroups?" style=dashed]

    // --- Edges: Registry feeds denorm ---
    registry -> denorm [label="field list\nper bucket" style=dashed]

    // --- Layout helpers ---
    {rank=same; proposal; refs_links}
    {rank=same; order; deep_copy}
    {rank=same; invoice; alice}
}
