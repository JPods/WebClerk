components:
  schemas:
    Action:
      type: object
      description: |-
        Base serializer enforcing role-based field visibility/edit rules.

        Uses settings-driven matrices (view_edit) via get_accessible_fields(table, mode, user).
        Subclasses should define Meta.model & Meta.fields normally; set model_name when needed.
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        ida:
          type: string
          maxLength: 40
        dt_created:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        dt_modified:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        version:
          type: integer
          maximum: 2147483647
          minimum: 0
        is_active:
          type: boolean
          description: Record is logically active
        security_level:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: Security level or classification
        is_deleted:
          type: boolean
        is_archived:
          type: boolean
        metadata:
          description: Universal metadata envelope
        refs:
          description: Keywords / tags / lightweight links
        prefs:
          description: User preferences / settings
        comments:
          description: Threaded notes / comment fields
        health_rating:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: Data quality rating (0-100)
        action:
          type: string
          nullable: true
          maxLength: 255
        action_by:
          type: string
          nullable: true
          maxLength: 255
        priority:
          type: string
          nullable: true
          maxLength: 255
        difficulty:
          type: string
          nullable: true
          maxLength: 255
        hours:
          type: number
          format: double
          nullable: true
        percent:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          nullable: true
        status:
          type: string
          nullable: true
          maxLength: 255
        quality:
          type: string
          nullable: true
          maxLength: 255
        description:
          type: string
          nullable: true
          maxLength: 255
        dt_action:
          type: string
          format: date-time
          nullable: true
        dt_completed:
          type: string
          format: date-time
          nullable: true
        dt_due:
          type: string
          format: date-time
          nullable: true
        dt_updated:
          type: string
          format: date-time
          nullable: true
      required:
      - id
      - uuid
    ActionEnum:
      enum:
      - commit
      - release
      type: string
      description: |-
        * `commit` - commit
        * `release` - release
    ApiLogin:
      type: object
      description: Login (email + password) -> JWT pair with email/role/name claims.
      properties:
        email:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    AttentionEnum:
      enum:
      - low
      - normal
      - high
      - critical
      type: string
      description: |-
        * `low` - Low
        * `normal` - Normal
        * `high` - High
        * `critical` - Critical
    BlankEnum:
      enum:
      - ''
    Connection:
      type: object
      description: |-
        Base serializer enforcing role-based field visibility/edit rules.

        Uses settings-driven matrices (view_edit) via get_accessible_fields(table, mode, user).
        Subclasses should define Meta.model & Meta.fields normally; set model_name when needed.
      properties:
        id:
          type: integer
          readOnly: true
        uuid:
          type: string
          format: uuid
          readOnly: true
          nullable: true
        name:
          type: string
          maxLength: 255
        type:
          type: string
          maxLength: 255
        config: {}
        is_active:
          type: boolean
          description: Record is logically active
        status:
          type: string
          nullable: true
          maxLength: 255
        scripts:
          nullable: true
        relationships:
          nullable: true
        action:
          type: string
          maxLength: 255
        comment:
          type: string
          description: General notes
        purpose:
          type: string
          nullable: true
          maxLength: 255
        maps:
          nullable: true
        encryption:
          nullable: true
        rules:
          nullable: true
        conflicts:
          nullable: true
        changes:
          nullable: true
        refs:
          description: Keywords / tags / lightweight links
        prefs:
          description: User preferences / settings
        metadata:
          description: Universal metadata envelope
        dt_created:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        dt_modified:
          type: integer
          maximum: 9223372036854775807
          minimum: -9223372036854775808
          format: int64
        version:
          type: integer
