{
  "info": {
    "name": "Universal API Core Contract",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Auth (signup/login) + universal wcapi save/get/query smoke & contract assertions."
  },
  "variable": [
    {"key": "email", "value": "ci_user@example.com"},
    {"key": "password", "value": "TestPass123!"},
    {"key": "contact_id", "value": ""},
    {"key": "contact_version", "value": ""},
    {"key": "access_token", "value": ""}
  ],
  "item": [
  {
      "name": "API Root",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""]}
      },
      "event": [
        {"listen": "test", "script": {"exec": [
          "pm.test('Root reachable', function () { pm.response.to.have.status(200); });"
        ], "type": "text/javascript"}}
      ]
    },
  {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"name_first\": \"CI\",\n  \"name_last\": \"User\"\n}"},
        "url": {"raw": "{{base_url}}/api/auth/signup/", "host": ["{{base_url}}"], "path": ["api","auth","signup",""]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Signup created or already exists', function () { pm.expect([201,400]).to.include(pm.response.code); });",
        "if (pm.response.code === 201) { var json = pm.response.json(); pm.collectionVariables.set('access_token', json.access); }"
      ], "type": "text/javascript"}}]
    },
  {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"},
        "url": {"raw": "{{base_url}}/api/auth/login/", "host": ["{{base_url}}"], "path": ["api","auth","login",""]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Login ok', function () { pm.response.to.have.status(200); });",
        "var json = pm.response.json(); pm.collectionVariables.set('access_token', json.access);"
      ], "type": "text/javascript"}}]
    },
  {
      "name": "Save Contact (wcapi/save)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{access_token}}"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"table_name\": \"contacts\",\n  \"name_first\": \"Contract\",\n  \"name_last\": \"Test\"\n}"},
        "url": {"raw": "{{base_url}}/wcapi/save/", "host": ["{{base_url}}"], "path": ["wcapi","save",""]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Save contact success', function () { pm.expect([200,201]).to.include(pm.response.code); });",
        "var json = pm.response.json(); pm.collectionVariables.set('contact_id', json.id || json.data && json.data.id);"
      ], "type": "text/javascript"}}]
    },
  {
      "name": "Get Contact (wcapi/get)",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/get/?table_name=contacts&id={{contact_id}}", "host": ["{{base_url}}"], "path": ["wcapi","get",""], "query": [
          {"key": "table_name", "value": "contacts"},
            {"key": "id", "value": "{{contact_id}}"}
        ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Get contact 200', function () { pm.response.to.have.status(200); });",
    "var js = pm.response.json(); pm.test('Contact id matches', function () { pm.expect(String(js.id || js.data && js.data.id)).to.eql(pm.collectionVariables.get('contact_id')); });",
    "var v = js.version || (js.data && js.data.version); if (v!==undefined) pm.collectionVariables.set('contact_version', v);"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Query Contacts (wcapi/query)",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/query/?table_name=contacts&limit=5", "host": ["{{base_url}}"], "path": ["wcapi","query",""], "query": [
          {"key": "table_name", "value": "contacts"}, {"key": "limit", "value": "5"}
        ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Query 200', function () { pm.response.to.have.status(200); });",
        "var js = pm.response.json(); pm.test('Query returns array/data', function(){ pm.expect(js.results || js.data || js.length).to.be.ok; });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Version Conflict (wcapi/save)",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{access_token}}"},
          {"key": "If-Match", "value": "0"}
        ],
        "body": {"mode": "raw", "raw": "{\n  \"table_name\": \"contacts\",\n  \"id\": {{contact_id}},\n  \"name_first\": \"Conflict\"\n}"},
        "url": {"raw": "{{base_url}}/wcapi/save/", "host": ["{{base_url}}"], "path": ["wcapi","save",""]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Conflict or success', function () { pm.expect([200, 409, 412]).to.include(pm.response.code); });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Allowed Fields (utilities)",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/utilities/allowed-fields/?table_name=contacts", "host": ["{{base_url}}"], "path": ["wcapi","utilities","allowed-fields",""] , "query": [ {"key":"table_name","value":"contacts"} ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Allowed fields 200', function () { pm.response.to.have.status(200); });",
        "var js = pm.response.json(); pm.test('Has fields list', function(){ pm.expect(js.fields || js.allowed || Object.keys(js).length).to.be.ok; });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Models Metadata (wcapi/models)",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/models/?table_name=contacts", "host": ["{{base_url}}"], "path": ["wcapi","models",""] , "query": [ {"key":"table_name","value":"contacts"} ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Models metadata 200', function () { pm.response.to.have.status(200); });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Metrics (wcapi/metrics)",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/metrics/", "host": ["{{base_url}}"], "path": ["wcapi","metrics",""]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Metrics 200', function () { pm.response.to.have.status(200); });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Negative Auth (missing token)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {"raw": "{{base_url}}/wcapi/query/?table_name=contacts&limit=1", "host": ["{{base_url}}"], "path": ["wcapi","query",""], "query": [
          {"key": "table_name", "value": "contacts"}, {"key": "limit", "value": "1"}
        ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Unauthorized or success depending on dev flag', function () { pm.expect([200,401,403]).to.include(pm.response.code); });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Query Pagination & Filter",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/query/?table_name=contacts&limit=2&offset=0&name_first=Contract", "host": ["{{base_url}}"], "path": ["wcapi","query",""], "query": [
          {"key": "table_name", "value": "contacts"},
          {"key": "limit", "value": "2"},
          {"key": "offset", "value": "0"},
          {"key": "name_first", "value": "Contract"}
        ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Pagination 200', function () { pm.response.to.have.status(200); });",
        "var js = pm.response.json(); var arr = js.results || js.data || []; pm.test('Limit respected (<=2)', function(){ pm.expect(arr.length).to.be.at.most(2); });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Models Schema Snapshot",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/models/?table_name=contacts", "host": ["{{base_url}}"], "path": ["wcapi","models",""] , "query": [ {"key":"table_name","value":"contacts"} ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "const baseline = ['id','name_first','name_last'];",
        "var js = pm.response.json();",
        "pm.test('Models schema 200', function(){ pm.response.to.have.status(200); });",
        "var fields = js.models && js.models.contacts ? js.models.contacts : js.models && js.models['contacts'] || [];",
        "pm.test('Baseline fields present', function(){ baseline.forEach(f=>pm.expect(fields).to.include(f)); });"
      ], "type": "text/javascript"}}]
    },
    {
      "name": "Response Time Guard (query contacts)",
      "request": {
        "method": "GET",
        "header": [ {"key": "Authorization", "value": "Bearer {{access_token}}"} ],
        "url": {"raw": "{{base_url}}/wcapi/query/?table_name=contacts&limit=5", "host": ["{{base_url}}"], "path": ["wcapi","query",""], "query": [
          {"key": "table_name", "value": "contacts"}, {"key": "limit", "value": "5"}
        ]}
      },
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('Query time < 1200ms', function(){ pm.expect(pm.response.responseTime).to.be.below(1200); });"
      ], "type": "text/javascript"}}]
    }
  ]
}
