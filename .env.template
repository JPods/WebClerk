# WebClerk3 — Environment Configuration
# Copy to .env and edit for your installation:  cp .env.template .env

# ── Secret Key (REQUIRED — generate your own) ───────────────────
# python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-key

# ── Database ────────────────────────────────────────────────────
LOCAL_DATABASE_NAME=commerce_expert
LOCAL_DATABASE_USER=postgres
LOCAL_DATABASE_PASS=
LOCAL_DATABASE_HOST=localhost
LOCAL_DATABASE_PORT=5432

# ── Identity ────────────────────────────────────────────────────
# DATA_SET_ID identifies this environment. IDA_PREFIX auto-derives from it.
DATA_SET_ID=LOCAL
DATA_SET_NAME=My WebClerk

# ── Mode ────────────────────────────────────────────────────────
DB_MODE=local
DEBUG=True

# ── Demo Data (first run) ──────────────────────────────────────
# Set to 1 to load demo data on first run (contacts, items, transactions)
LOAD_DEMO_DATA=1

# ── Read-Only Mode ─────────────────────────────────────────────
# Set to True for demo.webclerk.com — blocks all writes
READ_ONLY_MODE=False

# ── Email (optional) ───────────────────────────────────────────
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ── External Services (optional) ───────────────────────────────
# SENTRY_DSN=
# ZEROBOUNCE_API_KEY=
