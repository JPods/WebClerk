// WC3 RBAC & Field Access — role-based access control
// Setting records control what each role sees and edits per model
// Render: dot -Tpdf wc3-rbac-field-access.dot -o wc3-rbac-field-access.pdf

digraph wc3_rbac {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — RBAC & Field Access\nRole → Setting → what each user sees and edits"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── User ──
    user [label="User\n(auth_user)\n\nis_superuser\nis_staff" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=11]

    // ── UserProfile ──
    profile [label="UserProfile\n(core_userprofile)\n\ncontact_id\nrole\npermissions" fillcolor="#C5CAE9" color="#7986CB"]

    // ── Contact ──
    contact [label="Contact\n(contacts)\n\nroles: customer,\nemployee, rep,\nvendor, sales, admin" fillcolor="#BBDEFB" color="#64B5F6"]

    // ── Setting records ──
    subgraph cluster_settings {
        label="Setting Records (per model)"
        style="filled,rounded"
        fillcolor="#FFF8E1"
        color="#FFE082"
        fontsize=9
        fontcolor="#F57F17"

        field_access [label="field_access Setting\n\nviewFields by role\nsaveFields by role\nfield_behaviors\n(type, required, options)" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]

        query_scope [label="query_scope Setting\n\nrestricts external users\nto their own data\n(e.g., customer sees\nonly their orders)" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
    }

    // ── wcapi gateway ──
    wcapi [label="wcapi Gateway\n\ninject_role_filters()\napply field_access\napply query_scope\n\nsilently denies if\nno UserProfile" shape=octagon fillcolor="#C8E6C9" color="#81C784" fontsize=10]

    // ── Results ──
    subgraph cluster_results {
        label="What the User Experiences"
        style="filled,rounded"
        fillcolor="#F3E5F5"
        color="#CE93D8"
        fontsize=9
        fontcolor="#7B1FA2"

        view [label="View\nonly fields allowed\nfor their role" fillcolor="#E1BEE7" color="#BA68C8"]
        edit [label="Edit\nonly fields allowed\nfor their role" fillcolor="#E1BEE7" color="#BA68C8"]
        data [label="Data\nonly records within\ntheir query_scope" fillcolor="#E1BEE7" color="#BA68C8"]
    }

    // ── Superuser bypass ──
    bypass [label="Superuser\nsees everything\nedits everything\nno scope filter" fillcolor="#FFCDD2" color="#EF9A9A" fontsize=9]

    // ── Alice ──
    alice [label="Alice\nis_superuser = True\nown audit trail\nclaude@jpods.com" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]

    // ── Edges ──
    user -> profile [color="#7986CB"]
    profile -> contact [label="contact_id" color="#42A5F5"]
    contact -> wcapi [label="role" color="#5C6BC0"]

    field_access -> wcapi [label="what fields" color="#FFB300"]
    query_scope -> wcapi [label="what records" color="#FFB300"]

    wcapi -> view [color="#AB47BC"]
    wcapi -> edit [color="#AB47BC"]
    wcapi -> data [color="#AB47BC"]

    user -> bypass [label="is_superuser?" style=dashed color="#E57373"]
    bypass -> alice [style=dashed color="#29B6F6"]
}
