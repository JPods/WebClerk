# =============================================================================
# React2025 — Vite Frontend Environment
# =============================================================================
# This file is .gitignored.  See readmes/02-env-setup.md for documentation.
#
# All variables exposed to client code MUST start with VITE_.
# Restart the dev server after any change (vite caches env at startup).
# =============================================================================

# --------------- App Mode ----------------------------------------------------
VITE_ENV='DEV'
# VITE_ENV='PROD'
VITE_URL="http://localhost:5173"

# --------------- Developer Tools ---------------------------------------------
# Show component-name badges on detail pages, panels, and cards.
# Set to 'false' (or remove) to hide them.
VITE_DEBUG_BADGES='true'

# --------------- Data Set Identification -------------------------------------
# Should match the backend DATA_SET_ID / DATA_SET_NAME in webClerk3/.env
VITE_DATA_SET_ID='DEV'
VITE_DATA_SET_NAME='Development Server'

# --------------- API URLs ----------------------------------------------------
# Do NOT include /wcapi — the SDK appends it automatically.
VITE_API_URL="http://localhost:8000"
VITE_AUTH_API_URL="http://localhost:8000"
VITE_API_URL_PROD=""

# --------------- Third-Party APIs --------------------------------------------
VITE_NOTION_API_URL="https://api.notion.com/v1/"

# =============================================================================
# SWITCHING DATA SETS
# =============================================================================
# To switch between remote and local databases:
#
# Option 1: Click the color badge in bottom-left corner of the app
#   🟢 Green = REMOTE (team)  |  🔵 Blue = LOCAL (debug)
#
# Option 2: Run the shell script:
#   cd ../webClerk3/tools && ./switch-dataset.sh remote   # Team collaboration
#   cd ../webClerk3/tools && ./switch-dataset.sh local    # Local debugging
#
# The frontend config doesn't change — only the backend DB_MODE switches.
# =============================================================================