// WC3 Inventory Adjustment — physical count to system correction
// Tables: inventorycheck, inventorycheckline, inventoryadjustment, inventorymovement
// Render: dot -Tpdf wc3-inventory-adjustment.dot -o wc3-inventory-adjustment.pdf

digraph wc3_inv_adjustment {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Inventory Adjustment\nPhysical count → variance → adjustment → audit trail"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── Physical count ──
    count [label="Physical Count\n\nwarehouse walk\ncycle count\nfull inventory" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=11]

    // ── Check record ──
    inv_check [label="InventoryCheck\n(products_inventorycheck)\n\ndt, warehouse\nstatus: draft/posted" fillcolor="#C5CAE9" color="#7986CB"]

    inv_check_line [label="InventoryCheckLine\n(products_inventorycheckline)\n\nitem_id\ncounted_qty\nsystem_qty\nvariance" fillcolor="#BBDEFB" color="#64B5F6"]

    // ── Variance ──
    variance [label="Variance?" shape=diamond fillcolor="#FFF9C4" color="#FFF176" fontsize=11]

    // ── No variance ──
    ok [label="No Adjustment\ncount = system" fillcolor="#C8E6C9" color="#81C784" fontsize=9]

    // ── Adjustment ──
    adjustment [label="Inventory Adjustment\n(products_pendinginventoryadjustment)\n\nreason code\napproval" fillcolor="#FFE0B2" color="#FFB74D"]

    // ── Movement ──
    movement [label="InventoryMovement\n(products_inventorymovement)\n\nqty_change (+/-)\nitem_id\nwarehouse_id\nsource_type: adjustment" fillcolor="#E1BEE7" color="#BA68C8"]

    // ── Item impact ──
    item [label="Item Record\n\nquantity.on_hand\nupdated" fillcolor="#E1BEE7" color="#CE93D8"]

    // ── Layer impact ──
    layer [label="InventoryLayer\n\nadjusted or new\nlayer created" fillcolor="#E1BEE7" color="#CE93D8" fontsize=9]

    // ── GL ──
    gl [label="GL Journal\n\nDebit/Credit:\nInventory Adjustment\naccount" fillcolor="#C8E6C9" color="#43A047"]

    // ── Audit ──
    audit [label="AuditLog\n(audit_logs)\n\nwho, when, what\nreason, variance" fillcolor="#B3E5FC" color="#4FC3F7"]

    // ── Alice ──
    alice [label="Alice\npattern watch\nrecurring shrinkage\nby item/location" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]

    // ── Edges ──
    count -> inv_check [color="#7986CB"]
    inv_check -> inv_check_line [color="#5C6BC0"]
    inv_check_line -> variance [label="counted vs\nsystem" color="#42A5F5"]

    variance -> ok [label="zero" color="#66BB6A"]
    variance -> adjustment [label="non-zero" color="#E57373"]

    adjustment -> movement [label="post\nadjustment" color="#AB47BC" style=bold]
    movement -> item [label="update\non_hand" color="#CE93D8"]
    movement -> layer [label="adjust\nlayer qty" style=dashed color="#CE93D8"]
    movement -> gl [label="post\nGL entry" color="#43A047"]
    movement -> audit [label="record\naudit trail" color="#29B6F6"]

    audit -> alice [style=dashed color="#29B6F6"]
}
