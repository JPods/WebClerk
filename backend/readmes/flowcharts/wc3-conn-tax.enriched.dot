// WC3 Tax Calculation Flow — invoice line to tax determination
// Render: dot -Tpdf wc3-conn-tax.dot -o wc3-conn-tax.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_conn_tax {
    size="7.5,10.0"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — Tax Calculation Flow"
    labelloc=t

    // Invoice line
    inv_line [label="Invoice Line\n\nitem\nqty\nprice\nship-to" shape=box fillcolor="#D4E6F1"]

    // Multi-jurisdiction decision
    multi_juris [label="Multi-\njurisdiction?" shape=diamond fillcolor="#FADBD8"]

    // External tax API cluster
    subgraph cluster_tax_apis {
        label="External Tax APIs"
        style=filled fillcolor="#F5EEF8" color="#D7BDE2"
        avalara [label="Avalara" shape=box fillcolor="#E8DAEF" fontsize=8]
        taxjar [label="TaxJar" shape=box fillcolor="#E8DAEF" fontsize=8]
        vertex [label="Vertex" shape=box fillcolor="#E8DAEF" fontsize=8]
    }

    // External rate return
    ext_rate [label="Tax Rate +\nAmount\n\nstate\ncounty\ncity\nspecial district" shape=box fillcolor="#FCF3CF"]

    // Built-in path
    builtin [label="TaxJurisdiction\nRecords\n(Setting)\n\nrate per jurisdiction" shape=box fillcolor="#FCF3CF"]

    // Built-in rate
    builtin_rate [label="Tax Rate\n(single jurisdiction)" shape=box fillcolor="#FCF3CF"]

    // Tax line
    tax_line [label="Tax Line\n\njurisdiction\nrate\namount\ntaxable amount" shape=octagon fillcolor="#F5CBA7"]

    // Invoice
    invoice [label="Invoice\n(totals updated)\n\nsubtotal\ntax\ntotal" shape=box fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/invoice.py" target="_blank" tooltip="Invoice — shipment event. Financial event triggers GL and inventory movement.\nModel: apps/transactions/models/invoice.py\nFunctions:
  transfer_order_to_invoice @ apps/transactions/services/order_to_invoice.py:16 (creates invoice from order)
  Pending.objects.create @ apps/transactions/services/order_to_invoice.py:332 (-on_hand, -on_so, +on_in)\nPending deltas: on_hand: -qty, on_so: -qty, on_in: +qty\nGL: AR debit, Revenue credit, Tax credit, COGS debit, Inventory credit, Commission"]

    // GL journal
    journal [label="Tax Journal\nDebit AR\nCredit Tax Payable" shape=box fillcolor="#D5F5E3"]

    // Exemption check
    exempt [label="Tax\nExempt?" shape=diamond fillcolor="#FADBD8"]

    // Exemption record
    exemption [label="Exemption\nCertificate\n(on file)" shape=note fillcolor="#FCF3CF"]

    // Alice
    alice [label="Alice\nJurisdiction\nMonitoring\n\nrate changes\nnexus alerts\nexempt expiry" shape=box fillcolor="#AED6F1"]

    // Edges
    inv_line -> exempt
    exempt -> multi_juris [label="no"]
    exempt -> invoice [label="yes\ntax = 0"]
    exemption -> exempt [style=dashed]

    multi_juris -> avalara [label="yes"]
    multi_juris -> taxjar [label="yes"]
    multi_juris -> vertex [label="yes"]
    multi_juris -> builtin [label="no\nsingle\njurisdiction"]

    avalara -> ext_rate
    taxjar -> ext_rate
    vertex -> ext_rate

    builtin -> builtin_rate
    ext_rate -> tax_line
    builtin_rate -> tax_line
    tax_line -> invoice
    invoice -> journal [label="post"]

    ext_rate -> alice [label="rate\nchanges" style=dashed]
    builtin -> alice [label="monitor\nstale rates" style=dashed]
}
