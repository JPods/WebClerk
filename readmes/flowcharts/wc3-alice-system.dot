// WC3 Alice System — AI Assistant capability map
// Each node links to a Document record (ALICE-*) and git-hosted readme
// Render: dot -Tpdf wc3-alice-system.dot -o wc3-alice-system.pdf

digraph wc3_alice_system {
    rankdir=TB
    fontname="Helvetica"
    fontsize=11
    node [fontname="Helvetica" fontsize=10 style=filled]
    edge [fontname="Helvetica" fontsize=8]
    label="WC3 — Alice System\nAI Assistant: observe, learn, coach, enforce"
    labelloc=t
    fontsize=14
    pad=0.5

    // ── Core Identity ──────────────────────────────────────────
    alice [label="Alice\nWebClerk AI Assistant\n\nEvery WC3 installation\nLocal LLM + vector store" shape=diamond fillcolor="#F4D03F" fontsize=11 URL="ALICE-README"]

    // ── Learning Loop ──────────────────────────────────────────
    subgraph cluster_learning {
        label="Learning Loop"
        style=rounded
        color="#3498DB"
        fontcolor="#3498DB"

        observe [label="Observe\n\nconsole capture\nsignal handlers\nmanual" shape=box fillcolor="#D6EAF8" URL="ALICE-OBSERVATION-SETUP"]
        log [label="Log\n\nalice_log table\nalice_observation" shape=box fillcolor="#D6EAF8" URL="ALICE-OBSERVATION-SETUP"]
        pattern [label="Pattern\n\n5+ repeats / 7 days\nthresholds by type" shape=box fillcolor="#AED6F1" URL="ALICE-PATTERN-RECOGNITION"]
        recommend [label="Recommend\n\nalice_pending\nconfig_suggestion" shape=box fillcolor="#AED6F1" URL="ALICE-PATTERN-RECOGNITION"]
        promote [label="Promote\n\nSetting record\nBill approves" shape=box fillcolor="#85C1E9" URL="ALICE-PATTERN-RECOGNITION"]
    }

    // ── Data Quality ───────────────────────────────────────────
    subgraph cluster_quality {
        label="Data Quality"
        style=rounded
        color="#27AE60"
        fontcolor="#27AE60"

        tier1 [label="Tier 1\nHard Algorithms\n\nphone, email, zip\ndeterministic, zero cost" shape=box fillcolor="#ABEBC6" URL="ALICE-DATA-QUALITY"]
        tier2 [label="Tier 2\nAlice LLM\n\nlocal model\ninstallation patterns" shape=box fillcolor="#82E0AA" URL="ALICE-DATA-QUALITY"]
        tier3 [label="Tier 3\nGeneral LLM\n\nlong tail\nasks before calling" shape=box fillcolor="#58D68D" URL="ALICE-DATA-QUALITY"]
        polish [label="Data Polishing\n\nguess → review → validate\nnightly run" shape=box fillcolor="#ABEBC6" URL="ALICE-DATA-QUALITY"]
        dedup [label="Dedup\n\nscan → extract → bundle\nuser works through" shape=box fillcolor="#82E0AA" URL="ALICE-DEDUP"]
        field_size [label="Field Size\n\ninline thresholds\nauto-offload to Document" shape=box fillcolor="#ABEBC6" URL="ALICE-DATA-QUALITY"]
        file_storage [label="File Storage\n\npath enforcement\nimage sizes\ntenant isolation" shape=box fillcolor="#ABEBC6" URL="ALICE-DATA-QUALITY"]
    }

    // ── Coaching ───────────────────────────────────────────────
    subgraph cluster_coaching {
        label="Coaching & Training"
        style=rounded
        color="#E67E22"
        fontcolor="#E67E22"

        hint_bar [label="AliceHintBar\n\npatterns → suggestions\nanomalies → warnings\ncoaching → tips" shape=box fillcolor="#FDEBD0" URL="ALICE-OBSERVATION-SETUP"]
        quiz [label="Quiz Engine\n\nDocument records\n6 categories\n3 difficulties" shape=box fillcolor="#FAD7A0" URL="ALICE-OBSERVATION-SETUP"]
        presets [label="AlicePreset\n\nsaved searches\nlayouts, workflows\nretired after 90d" shape=box fillcolor="#FDEBD0" URL="ALICE-OBSERVATION-SETUP"]
    }

    // ── Escalation ─────────────────────────────────────────────
    escalation [label="Escalation\n\nhonest capability boundary\nAction record → Claude Code" shape=box fillcolor="#F5B7B1" URL="ALICE-ESCALATION"]

    // ── Infrastructure ─────────────────────────────────────────
    subgraph cluster_infra {
        label="Infrastructure"
        style=rounded
        color="#8E44AD"
        fontcolor="#8E44AD"

        vector_store [label="Vector Store\n\n.chroma_db_alice\nWC3 source + readmes" shape=cylinder fillcolor="#E8DAEF" URL="ALICE-TOOLKIT"]
        mcp [label="MCP Server\n\nask, search, observe\nrecall, quiz" shape=box fillcolor="#D2B4DE" URL="ALICE-LEARNING"]
        ollama [label="Ollama\n\nlocal LLM\nalice:latest" shape=box fillcolor="#E8DAEF" URL="ALICE-SETUP-GUIDE"]
        console_capture [label="Console Capture\n\nauto 60s flush\nerrors → observations" shape=box fillcolor="#D2B4DE" URL="ALICE-SETUP-GUIDE"]
        patterns_py [label="alice-patterns.py\n\nevery 4 hours\ncommerce DB scan" shape=box fillcolor="#E8DAEF" URL="ALICE-LEARNING"]
    }

    // ── Edges ──────────────────────────────────────────────────

    // Core connections
    alice -> observe [label="watches" color="#3498DB"]
    alice -> tier1 [label="enforces" color="#27AE60"]
    alice -> hint_bar [label="coaches" color="#E67E22"]
    alice -> escalation [label="honest limit" color="#E74C3C"]

    // Learning loop flow
    observe -> log [color="#3498DB"]
    log -> pattern [color="#3498DB"]
    pattern -> recommend [color="#3498DB"]
    recommend -> promote [label="Bill approves" color="#3498DB"]

    // Data quality cascade
    tier1 -> tier2 [label="can't resolve" color="#27AE60"]
    tier2 -> tier3 [label="low confidence" color="#27AE60"]
    tier1 -> dedup [color="#27AE60"]
    tier2 -> polish [label="nightly" color="#27AE60"]
    tier1 -> field_size [color="#27AE60"]
    tier1 -> file_storage [color="#27AE60"]

    // Coaching from patterns
    pattern -> hint_bar [color="#E67E22"]
    pattern -> presets [label="confirmed" color="#E67E22"]
    promote -> presets [color="#E67E22"]

    // Infrastructure feeds
    console_capture -> observe [color="#8E44AD"]
    patterns_py -> log [color="#8E44AD"]
    vector_store -> mcp [color="#8E44AD"]
    ollama -> mcp [color="#8E44AD"]

    // Escalation
    tier2 -> escalation [label="complex" color="#E74C3C"]
    dedup -> escalation [label="> 5 dups" color="#E74C3C"]

    // Cross-system
    allie [label="Allie\n\ncross-domain context\nsovereignty review" shape=diamond fillcolor="#D5F5E3" URL="readmes/agents/allie.md"]
    recommend -> allie [label="validates" color="#1ABC9C" style=dashed]
    allie -> promote [label="confirms" color="#1ABC9C" style=dashed]

    // Quiz
    quiz -> hint_bar [label="drill results" color="#E67E22" style=dashed]
}
