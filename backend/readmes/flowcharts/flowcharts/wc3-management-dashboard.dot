// WC3 Management Dashboard — input efforts → evaluation → results
// From wc2 page 20: Four efforts cross-connect to outputs and results
// Render: dot -Tpdf wc3-management-dashboard.dot -o wc3-management-dashboard.pdf

digraph wc3_management_dashboard {
    rankdir=LR
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Management Dashboard\nInput efforts → evaluation → business results"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.4
    ranksep=1.2

    // ── Input efforts ──
    subgraph cluster_input {
        label="Input Efforts"
        style="filled,rounded"
        fillcolor="#E8F5E9"
        color="#A5D6A7"
        fontsize=9
        fontcolor="#2E7D32"

        sales_effort [label="Sales\nEffort" fillcolor="#C8E6C9" color="#81C784"]
        purchasing_effort [label="Purchasing\nEffort" fillcolor="#C8E6C9" color="#81C784"]
        inventory_effort [label="Inventory\nEffort" fillcolor="#C8E6C9" color="#81C784"]
        production_effort [label="Production\nEffort" fillcolor="#C8E6C9" color="#81C784"]
    }

    // ── Evaluation engines ──
    subgraph cluster_eval {
        label="Evaluation"
        style="filled,rounded"
        fillcolor="#FFF8E1"
        color="#FFE082"
        fontsize=9
        fontcolor="#F57F17"

        sync_eval [label="Sync\n(roving sales)" fillcolor="#FFF9C4" color="#FFF176"]
        item_period [label="Item / Period\nSales" fillcolor="#FFF9C4" color="#FFF176"]
        sales_eval [label="Sales\nEvaluation" fillcolor="#FFF9C4" color="#FFF176"]
        forecasting [label="Forecasting" fillcolor="#FFF9C4" color="#FFF176"]
    }

    // ── Business results ──
    subgraph cluster_results {
        label="Business Results"
        style="filled,rounded"
        fillcolor="#F3E5F5"
        color="#CE93D8"
        fontsize=9
        fontcolor="#7B1FA2"

        cash_flow [label="Cash Flow" fillcolor="#E1BEE7" color="#BA68C8"]
        ad_perf [label="Ad Source\nPerformance" fillcolor="#E1BEE7" color="#BA68C8"]
        commissions [label="Commissions" fillcolor="#E1BEE7" color="#BA68C8"]
    }

    // ── Alice ──
    alice [label="Alice\nenterprise\npattern watch" fillcolor="#B3E5FC"
           color="#4FC3F7" fontsize=9]

    // ── Cross-connections (efforts → evaluation) ──
    sales_effort -> sync_eval [color="#66BB6A"]
    sales_effort -> item_period [color="#66BB6A"]
    sales_effort -> sales_eval [color="#66BB6A"]
    sales_effort -> forecasting [color="#66BB6A"]

    purchasing_effort -> item_period [color="#66BB6A"]
    purchasing_effort -> sales_eval [color="#66BB6A"]
    purchasing_effort -> forecasting [color="#66BB6A"]

    inventory_effort -> item_period [color="#66BB6A"]
    inventory_effort -> sales_eval [color="#66BB6A"]
    inventory_effort -> forecasting [color="#66BB6A"]

    production_effort -> sales_eval [color="#66BB6A"]
    production_effort -> forecasting [color="#66BB6A"]

    // ── Evaluation → results ──
    sync_eval -> cash_flow [color="#AB47BC"]
    item_period -> ad_perf [color="#AB47BC"]
    sales_eval -> commissions [color="#AB47BC"]
    sales_eval -> cash_flow [color="#AB47BC"]
    forecasting -> cash_flow [color="#AB47BC"]
    item_period -> cash_flow [style=dashed color="#AB47BC"]

    // ── Alice watches everything ──
    cash_flow -> alice [style=dashed color="#29B6F6"]
    commissions -> alice [style=dashed color="#29B6F6"]
    ad_perf -> alice [style=dashed color="#29B6F6"]
}
