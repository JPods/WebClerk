// WC3 Bill of Materials — assembly tree, build, cost rollup
// Item → BOM tree → consume → propagate cost → where-used
// Render: dot -Tpdf wc3-bom.dot -o wc3-bom.pdf

digraph wc3_bom {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Bill of Materials\nAssembly tree: expand, build, cost rollup, where-used"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── Assembly ──
    assembly [label="Assembly Item\n(parent)\n\ncost.avg (recorded)\ncost.bom (calculated)" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=11]

    // ── BOM tree ──
    subgraph cluster_tree {
        label="BOM Tree (expand_tree endpoint)"
        style="filled,rounded"
        fillcolor="#F0F4F8"
        color="#B0BEC5"
        fontsize=9
        fontcolor="#546E7A"

        comp_a [label="Component A\nqty: 3\ncost: $5.00" fillcolor="#C5CAE9" color="#7986CB"]
        comp_b [label="Component B\nqty: 2\ncost: $8.00" fillcolor="#C5CAE9" color="#7986CB"]
        sub_assy [label="Sub-Assembly C\nqty: 1" fillcolor="#BBDEFB" color="#64B5F6"]
        comp_c1 [label="Component C1\nqty: 4\ncost: $2.00" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]
        comp_c2 [label="Component C2\nqty: 1\ncost: $12.00" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]
    }

    // ── Consume (build) ──
    consume [label="Consume / Build\n(consume endpoint)\n\n+qty receipt for assembly\n-qty issue for each component\n× build quantity\n\nadjust_for_on_hand option:\nnet against existing stock" shape=octagon fillcolor="#C8E6C9" color="#81C784" fontsize=10]

    // ── Inventory movements ──
    movements [label="InventoryMovements\n\n+5 Assembly (receipt)\n-15 Comp A (5×3)\n-10 Comp B (5×2)\n-5 Sub-Assy C (5×1)" fillcolor="#FFE0B2" color="#FFB74D" fontsize=9]

    // ── Cost rollup ──
    cost_rollup [label="propagate_cost_up\n\nComponent cost changes\n→ recalc sub-assembly\n→ recalc parent assembly\n→ all the way to top" shape=octagon fillcolor="#FFF9C4" color="#FFF176"]

    // ── Where-used ──
    where_used [label="Where-Used\n(find_top_level_assemblies)\n\nComponent C1 changed cost?\n→ which assemblies affected?\n→ impact analysis" fillcolor="#E1BEE7" color="#BA68C8"]

    // ── Three-cost comparison ──
    three_cost [label="Three-Cost System\n\ncost.avg (recorded/imported)\ncost.bom (from components)\ncost.last (last PO)\n\nVariance = signal to update" fillcolor="#FFCDD2" color="#EF9A9A" fontsize=9]

    // ── Work Order ──
    work_order [label="Work Order\n(work_orders)\n\nproduction tracking\nsteps, time, materials" fillcolor="#B3E5FC" color="#4FC3F7" fontsize=9]

    // ── Edges ──
    assembly -> comp_a [color="#7986CB"]
    assembly -> comp_b [color="#7986CB"]
    assembly -> sub_assy [color="#7986CB"]
    sub_assy -> comp_c1 [color="#42A5F5"]
    sub_assy -> comp_c2 [color="#42A5F5"]

    assembly -> consume [label="build qty" color="#66BB6A" style=bold]
    consume -> movements [color="#FF8F00"]

    comp_a -> cost_rollup [style=dashed color="#FFB300"]
    cost_rollup -> sub_assy [label="recalc" style=dashed color="#FFB300"]
    cost_rollup -> assembly [label="recalc" style=dashed color="#FFB300"]

    comp_c1 -> where_used [label="cost\nchanged?" style=dashed color="#AB47BC"]
    where_used -> assembly [label="affected\nassemblies" style=dashed color="#AB47BC"]

    assembly -> three_cost [style=dashed color="#E57373"]
    assembly -> work_order [label="production" style=dashed color="#29B6F6"]
}
