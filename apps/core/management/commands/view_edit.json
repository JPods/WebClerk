[
  {
    "is_active": true,
    "name": "contact",
    "purpose": "view_edit",
    "role": "all",
    "model_name": "contact",
    "data": {
      "__meta__": {
        "search": {
          "fields": ["name_first", "name_last", "email", "company"],
          "keywords": { "type": "array", "field": "refs__keywords" } 
        },
        "query": {
          "allow_fields": ["id","email","company","name_first","name_last","is_active","date_joined","role"],
          "allow_ops": ["eq","ne","lt","lte","gt","gte","icontains","contains","in","isnull","startswith","istartswith"],
          "allow_joins": { "emails": "emails", "phones": "phones" },
          "max_depth": 1,
          "max_rows": 200
        },
        "relations": {
          "emails": { "type": "reverse", "fields": ["id", "email"], "limit": 10 },
          "phones": { "type": "reverse", "fields": ["id", "number"], "limit": 10 }
        },
        "ordering": ["-date_joined"],
        "filters": { "allow": ["company", "is_active", "role"] },
        "pagination": { "page_size": 25, "max_page_size": 200 },
        "soft_delete": { "enabled": true, "field": "is_active", "false_value": false, "retention_days": 60 },
        "hooks": {
          "pre_save": "apps.accounts.hooks.contact_pre_save",
          "post_save": "apps.accounts.hooks.contact_post_save"
        },
        "views": {
          "compact": {
            "ctx": "list",
            "relations": {},                      
            "pagination": { "page_size": 5, "max_page_size": 5 },
            "fields": { "view": ["id", "email", "name_first", "name_last"] }
          },
          "audit": {
            "ctx": "display",
            "ordering": ["-date_joined"],
            "relations": { "emails": { "type": "reverse", "fields": ["id", "email"], "limit": 3 } }
          }
        }
      },
      "SUPER": { "view": ["id","email","opt_out","password","role","role_default","is_email_verified","is_active","is_staff","last_login","attention","comment_alert","company","name_first","name_last","name_middle","prefix","suffix","salutation","publish","rank","date_joined","comment","verification_code","verification_code_expiry"],
                 "edit": ["id","email","opt_out","password","role","role_default","is_email_verified","is_active","is_staff","last_login","attention","comment_alert","company","name_first","name_last","name_middle","prefix","suffix","salutation","publish","rank","date_joined","comment","verification_code","verification_code_expiry"] },
      "ADMIN": { "view": ["id","email","opt_out","role","role_default","is_email_verified","is_active","is_staff","last_login","attention","comment_alert","company","name_first","name_last","name_middle","prefix","suffix","salutation","publish","rank","date_joined","comment"],
                 "edit": ["email","opt_out","role","role_default","is_email_verified","is_active","is_staff","attention","comment_alert","company","name_first","name_last","name_middle","prefix","suffix","salutation","publish","rank","comment"] },
      "SALE":  { "view": ["id","email","role","role_default","company","name_first","name_last","name_middle","prefix","suffix","salutation","publish","rank","date_joined"],
                 "edit": ["company","name_first","name_last","name_middle","prefix","suffix","salutation"] },
      "REP":   { "view": ["id","email","role","role_default","company","name_first","name_last","name_middle","prefix","suffix","salutation","publish","rank"],
                 "edit": ["company","name_first","name_last","name_middle","prefix","suffix","salutation"] },
      "VENDOR":{ "view": ["id","email","company","name_first","name_last","name_middle","prefix","suffix","salutation"],
                 "edit": ["company","name_first","name_last","name_middle","prefix","suffix","salutation"] },
      "CUSTOMER": { "view": ["id","email","name_first","name_last","name_middle","prefix","suffix","salutation"],
                    "edit": ["name_first","name_last","name_middle","prefix","suffix","salutation"] },
      "USER":  { "view": ["id","email","name_first","name_last"], "edit": ["name_first","name_last"] },
      "PUBLIC":{ "view": ["name_first","name_last","company"], "edit": [] }
    },
    "comment": ""
