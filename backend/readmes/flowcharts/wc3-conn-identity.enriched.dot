// WC3 Connection: MyCarryOn Identity — sovereign identity and context sync
// Render: dot -Tpdf wc3-conn-identity.dot -o wc3-conn-identity.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_conn_identity {
    size="7.5,10.0"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 Connection — MyCarryOn Identity Flow"
    labelloc=t

    // ── Person ──
    person [label="Person\n(sovereign individual)\n\nOwns their identity\nControls all permissions" shape=box fillcolor="#D4E6F1"]

    // ── MyCarryOn ──
    mycarryon [label="MyCarryOn\n(mycarryon.io)\n\nPortable identity store\nOwner-controlled\nEncrypted at rest" shape=box fillcolor="#E8DAEF"]

    // ── Permissions ──
    permissions [label="Permissions\n\nEnumerated\nRevocable\nSunset date required\nNo blanket grants" shape=box fillcolor="#FCF3CF"]

    // ── Permission decision ──
    perm_check [label="Permission\nGranted?" shape=diamond fillcolor="#FADBD8"]

    // ── carryon_uuid pointer ──
    pointer [label="carryon_uuid\n\nPointer only\nNo identity data stored\nResolves to MyCarryOn" shape=box fillcolor="#F5CBA7"]

    // ── WC3 Contact ──
    contact [label="WC3 Contact\n(Contact model)\n\nHolds pointer\nNot identity\nLocal commerce data only" shape=box fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/contacts/models/contact.py" target="_blank" tooltip="Central identity — customers, vendors, employees. Has related Email, Phone, Address models.\nModel: apps/contacts/models/contact.py"]

    // ── Context Sync ──
    sync [label="Bidirectional\nContext Sync\n\nBundle exchange\nConflict resolution\nAudit trail" shape=octagon fillcolor="#F5CBA7"]

    // ── Sovereignty note ──
    boundary [label="SOVEREIGNTY RULE\n\nWC3 holds pointer,\nnot identity.\nPerson is sovereign.\nPerson can revoke\nat any time." shape=note fillcolor="#FADBD8"]

    // ── Permission sunset ──
    sunset [label="Permission Sunset\n\nAuto-expires\nRequires renewal\nNo perpetual grants" shape=box fillcolor="#D5F5E3"]

    // ── Edges ──
    person -> mycarryon [label="stores\nidentity"]
    person -> permissions [label="grants\npermissions"]
    permissions -> perm_check
    perm_check -> pointer [label="yes"]
    perm_check -> person [label="no\ndenied" style=dashed]

    mycarryon -> pointer [label="resolves"]
    pointer -> contact [label="links to\nWC3 record"]

    contact -> sync [label="context\nexchange" dir=both]
    mycarryon -> sync [label="context\nexchange" dir=both]

    permissions -> sunset [label="all permissions\nhave sunset"]
    sunset -> perm_check [style=dashed label="expired?\nre-check"]

    // ── Boundary placement ──
    contact -> boundary [style=invis]
}
