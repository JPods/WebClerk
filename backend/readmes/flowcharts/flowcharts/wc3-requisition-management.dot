// WC3 Requisition Management — internal procurement request loop
// From wc2 page 12: Proposals ↔ Requisition ↔ Orders ↔ POs
// Render: dot -Tpdf wc3-requisition-management.dot -o wc3-requisition-management.pdf

digraph wc3_requisition {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Requisition Management\nInternal procurement: request → approve → purchase"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.8
    ranksep=0.9

    // ── Sources ──
    proposals [label="Proposals\n(anticipated need)" fillcolor="#E8EAF6" color="#9FA8DA"]
    orders [label="Orders\n(committed need)" fillcolor="#C5CAE9" color="#7986CB"]

    // ── Requisition engine ──
    req_mgmt [label="Requisition\nManagement" shape=octagon fillcolor="#FFF9C4"
              color="#FFF176" fontsize=11]

    // ── Request record ──
    requisition [label="Request /\nRequisition\n\nwhat is needed\nqty, specs\nrequested by\napproval status"
                 fillcolor="#BBDEFB" color="#64B5F6" fontsize=10]

    // ── Item specs ──
    item_specs [label="Item Specs\n(requirements)" fillcolor="#FFE0B2" color="#FFB74D" fontsize=9]

    // ── Output ──
    po [label="Purchase Order\n(to vendor)" fillcolor="#C8E6C9" color="#81C784"]

    // ── Edges ──
    proposals -> req_mgmt [label="anticipated\nmaterials" color="#5C6BC0" dir=both]
    orders -> req_mgmt [label="committed\nmaterials" color="#5C6BC0"]

    req_mgmt -> requisition [color="#42A5F5" dir=both]
    requisition -> po [label="approved →\ngenerate PO" color="#66BB6A"]
    po -> req_mgmt [label="PO status\nfeedback" style=dashed color="#90A4AE"]

    item_specs -> requisition [style=dashed color="#FF8F00"]
}
