// WC3 Order-to-Invoice Flow — from wc2 flow chart page 3, updated with wc3 models
// Render: dot -Tpdf wc3-order-to-invoice.dot -o wc3-order-to-invoice.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_order_to_invoice {
    size="10.0,7.5"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WC3 — Order to Invoice Flow\n(with inventory bucket effects)"
    labelloc=t

    // Customer setup
    customer [label="Customer\n(Contact + Customer)" shape=box fillcolor="#D4E6F1"]

    subgraph cluster_customer_attrs {
        label="Customer Attributes"
        style=filled fillcolor="#EBF5FB" color="#AED6F1"
        carrier [label="Carrier" shape=box fillcolor="#FDFEFE" fontsize=8]
        typesale [label="Type Sale\n(price_level)" shape=box fillcolor="#FDFEFE" fontsize=8]
        credit [label="Credit\n(financial)" shape=box fillcolor="#FDFEFE" fontsize=8]
        source [label="AdSource\n(metadata.source)" shape=box fillcolor="#FDFEFE" fontsize=8]
        salesid [label="Sales ID" shape=box fillcolor="#FDFEFE" fontsize=8]
        rep [label="Rep" shape=box fillcolor="#FDFEFE" fontsize=8]
        terms [label="Terms" shape=box fillcolor="#FDFEFE" fontsize=8]
        taxjuris [label="Tax Juris\n(Setting)" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // Items
    items [label="Item\n(products)" shape=box fillcolor="#FCF3CF"]

    // Verify
    verify [label="Verify details\nprice point\navailability" shape=octagon fillcolor="#F5CBA7"]

    // Order
    order [label="Order\n(Order model)\n\non_so += qty" shape=box fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/order.py" target="_blank" tooltip="Sales order — customer commitment. Creates +on_so and -on_p pending records.\nModel: apps/transactions/models/order.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (creates order from proposal)
  _create_transfer_pending_records @ apps/transactions/services/proposal_to_order.py:131 (pending records for +on_so, -on_p)\nPending deltas: on_so: +qty, on_p: -qty"]

    // Production
    production [label="Order\nProduction" shape=octagon fillcolor="#F5CBA7"]

    // Production inputs
    subgraph cluster_production {
        label="Production Records"
        style=filled fillcolor="#FEF9E7" color="#F9E79F"
        po [label="Purchase\nOrders\non_po += qty" shape=box fillcolor="#FDFEFE" fontsize=8]
        wo [label="Work\nOrders\non_wo += qty" shape=box fillcolor="#FDFEFE" fontsize=8]
        time_rec [label="Time" shape=box fillcolor="#FDFEFE" fontsize=8]
        materials [label="Materials" shape=box fillcolor="#FDFEFE" fontsize=8]
        wo_steps [label="WO Steps" shape=box fillcolor="#FDFEFE" fontsize=8]
    }

    // Proposal and Requisition
    proposal [label="Proposal\n\non_p += qty×prob" shape=box fillcolor="#E8DAEF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/proposal.py" target="_blank" tooltip="Sales proposal — forecast. on_p tracks weighted probability.\nModel: apps/transactions/models/proposal.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (converts proposal to order)\nPending deltas: on_p: +qty_x_prob"]
    requisition [label="Requisition" shape=box fillcolor="#E8DAEF"]

    // Workflow decision
    workflow [label="Work Flow\nComplete?" shape=diamond fillcolor="#FADBD8"]

    // Outcomes
    backorder [label="Maintain\nBackorder" shape=octagon fillcolor="#F5CBA7"]
    invoice [label="Invoice\n(Invoice model)\n\non_hand -= qty\non_so -= qty\non_in += qty" shape=box fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/invoice.py" target="_blank" tooltip="Invoice — shipment event. Financial event triggers GL and inventory movement.\nModel: apps/transactions/models/invoice.py\nFunctions:
  transfer_order_to_invoice @ apps/transactions/services/order_to_invoice.py:16 (creates invoice from order)
  Pending.objects.create @ apps/transactions/services/order_to_invoice.py:332 (-on_hand, -on_so, +on_in)\nPending deltas: on_hand: -qty, on_so: -qty, on_in: +qty\nGL: AR debit, Revenue credit, Tax credit, COGS debit, Inventory credit, Commission"]

    // Edges
    customer -> verify
    items -> verify
    proposal -> order [style=dashed]
    proposal -> requisition [style=dashed]
    requisition -> po [style=dashed]
    verify -> order
    order -> production
    po -> production [style=dashed]
    wo -> production [style=dashed]
    time_rec -> production [style=dashed]
    materials -> production [style=dashed]
    wo_steps -> wo [style=dashed]
    production -> workflow
    workflow -> backorder [label="partial"]
    workflow -> invoice [label="complete"]
    backorder -> order [label="remaining\nqty" style=dashed]

    carrier -> customer [style=invis]
}
