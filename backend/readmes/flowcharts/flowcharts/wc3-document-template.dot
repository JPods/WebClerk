// WC3 Document Template — template-driven save behavior
// From Miro_templates: query template → run scripts → role-based fields
// Render: dot -Tpdf wc3-document-template.dot -o wc3-document-template.pdf

digraph wc3_document_template {
    rankdir=TB
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Document Templates\nTemplate-driven: role-based fields, scripts, denormalization"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.6
    ranksep=0.7

    // ── Trigger ──
    trigger [label="New / Save\nRecord" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=11]

    // ── Template query ──
    query [label="Query Template\n\nname\npurpose\ntableName" shape=parallelogram fillcolor="#FFF9C4" color="#FFF176"]

    // ── Found? ──
    found [label="Template\nFound?" shape=diamond fillcolor="#C8E6C9" color="#81C784"]

    // ── Template library ──
    library [label="WebClerk Library\n(templates table)\n\nWeb-based library\nof templates" shape=cylinder fillcolor="#E1BEE7" color="#BA68C8" fontsize=10]

    // ── Template structure ──
    subgraph cluster_template {
        label="Template Document Structure"
        style="filled,rounded"
        fillcolor="#FFF8E1"
        color="#FFE082"
        fontsize=9
        fontcolor="#F57F17"

        purpose_field [label="purpose:\nuserInterface" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
        table_field [label="tableName:\ncontacts, orders..." fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
        script_before [label="scriptBefore\n(pre-save logic)" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
        script_after [label="scriptAfter\n(post-save logic)" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
        denorm [label="denormalize:\nfields → keywords" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
        view_fields [label="viewFields\nby role\n(what each role sees)" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
        save_fields [label="saveFields\nby role\n(what each role edits)" fillcolor="#FFF9C4" color="#FFF176" fontsize=9]
    }

    // ── Roles ──
    subgraph cluster_roles {
        label="Roles"
        style="filled,rounded"
        fillcolor="#F0F4F8"
        color="#B0BEC5"
        fontsize=9
        fontcolor="#546E7A"

        admin [label="ADMIN" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=9]
        user [label="USER" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=9]
        rep [label="REP" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=9]
        vendor_role [label="VENDOR" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=9]
        sales [label="SALES" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=9]
        customer_role [label="CUSTOMER" fillcolor="#E8EAF6" color="#9FA8DA" fontsize=9]
    }

    // ── Execute ──
    execute [label="Run Scripts\nDenormalize fields\ninto keywords" fillcolor="#C8E6C9" color="#66BB6A" fontsize=10]

    // ── Edges ──
    trigger -> query [color="#7986CB"]
    query -> found [color="#5C6BC0"]
    found -> library [label="lookup" color="#AB47BC"]
    library -> found [style=dashed color="#AB47BC"]

    found -> execute [label="yes" color="#66BB6A"]
    found -> trigger [label="no template\nsave normally" style=dashed color="#90A4AE"]

    library -> purpose_field [style=invis]
    library -> view_fields [style=invis]
    library -> save_fields [style=invis]

    view_fields -> admin [color="#7986CB"]
    view_fields -> user [color="#7986CB"]
    view_fields -> rep [color="#7986CB"]
    save_fields -> vendor_role [color="#7986CB"]
    save_fields -> sales [color="#7986CB"]
    save_fields -> customer_role [color="#7986CB"]

    script_before -> execute [color="#FFB300"]
    script_after -> execute [color="#FFB300"]
    denorm -> execute [color="#FFB300"]
}
