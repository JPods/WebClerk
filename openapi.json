    Login:
      type: object
      description: |-
        Obtain JWT pair with basic role validation and enriched custom claims.

        NOTE: Model uses a single string field `role` (not a list). Earlier code used
        membership (role in user.role) which incorrectly treated the role string as
        an iterable of characters. We now enforce simple equality.
      properties:
        email:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
        role:
          allOf:
          - $ref: '#/components/schemas/RoleEnum'
          description: |-
            Single role value (e.g., 'admin')

            * `user` - User
            * `admin` - Administrator
            * `manager` - Manager
            * `staff` - Staff
            * `guest` - Guest
      required:
      - email
      - password
      - role
    OptOutEnum:
      enum:
      - opted_out
      - bounced
      - invalid
      - spam_complaint
      type: string
      description: |-
        * `` - Active
        * `opted_out` - Opted Out
        * `bounced` - Bounced
        * `invalid` - Invalid
        * `spam_complaint` - Spam Complaint
