// WC3 Master Commerce Flow — based on wc2 WebClerkComExFlowCharts page 1
// Updated with wc3 model names and architecture
// Render: dot -Tpdf wc3-master-flow.dot -o wc3-master-flow.pdf

// CodeMap revision: 1 — 2026-08-11

digraph wc3_master_flow {
    size="7.5,10.0"
    ratio="compress"



    // ── CodeMap Standard Style ──
    fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
    fontsize=12
    bgcolor="white"
    pad=0.4
    nodesep=0.5
    ranksep=0.6
    splines=true

    node [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        style="filled,rounded"
        shape=box
        penwidth=1.2
        color="#555555"
    ]

    edge [
        fontname="Helvetica Neue,Helvetica,Arial,sans-serif"
        fontsize=10
        penwidth=2.0
        arrowhead=normal
        arrowsize=1.4
        color="#666666"
        fontcolor="#444444"
    ]

    rankdir=TB
    label="WebClerk 3 — Master Commerce Flow\n(wc3 model names)"
    labelloc=t

    // ── Style classes ──
    node [shape=box fillcolor="#E8E8E8" color="#666666"]

    // ── Entry ──
    market [label="Market Potential\n→ Customer wants\n→ Your capabilities" shape=parallelogram fillcolor="#D4E6F1"]
    comms [label="Communications\n(Communication model)" shape=box fillcolor="#AED6F1"]

    // ── Core transaction flow ──
    contact [label="Contact\nManagement" shape=diamond fillcolor="#FADBD8" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/contacts/models/contact.py" target="_blank" tooltip="Central identity — customers, vendors, employees. Has related Email, Phone, Address models.\nModel: apps/contacts/models/contact.py"]
    proposal [label="Proposal" fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/proposal.py" target="_blank" tooltip="Sales proposal — forecast. on_p tracks weighted probability.\nModel: apps/transactions/models/proposal.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (converts proposal to order)\nPending deltas: on_p: +qty_x_prob"]
    order [label="Order\n(Order model)" fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/order.py" target="_blank" tooltip="Sales order — customer commitment. Creates +on_so and -on_p pending records.\nModel: apps/transactions/models/order.py\nFunctions:
  transfer_proposal_to_order @ apps/transactions/services/proposal_to_order.py:219 (creates order from proposal)
  _create_transfer_pending_records @ apps/transactions/services/proposal_to_order.py:131 (pending records for +on_so, -on_p)\nPending deltas: on_so: +qty, on_p: -qty"]
    backorder [label="Maintain\nBackorder" shape=octagon fillcolor="#F5CBA7"]
    invoice [label="Invoice\n(Invoice model)" fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/invoice.py" target="_blank" tooltip="Invoice — shipment event. Financial event triggers GL and inventory movement.\nModel: apps/transactions/models/invoice.py\nFunctions:
  transfer_order_to_invoice @ apps/transactions/services/order_to_invoice.py:16 (creates invoice from order)
  Pending.objects.create @ apps/transactions/services/order_to_invoice.py:332 (-on_hand, -on_so, +on_in)\nPending deltas: on_hand: -qty, on_so: -qty, on_in: +qty\nGL: AR debit, Revenue credit, Tax credit, COGS debit, Inventory credit, Commission"]
    payment [label="Payment\n(AR/AP)" fillcolor="#ABEBC6" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/payment.py" target="_blank" tooltip="Payment — handles AR (received) and AP (expense). Signed amounts. Category maps to GL. Statement Sorter feeds expense side.\nModel: apps/transactions/models/payment.py\nFunctions:
  Payment @ apps/transactions/models/payment.py:1 (AR+AP via type field; signed amounts)"]

    // ── Objectives & management ──
    objectives [label="Set Objectives\nPerformance, Commissions\nCustomer Service\n(Project + Action)" fillcolor="#D5D8DC"]
    forecast [label="Forecast" shape=octagon fillcolor="#F5CBA7"]
    risk [label="Manage\nFinancial Risk\n(Customer.financial)" fillcolor="#D5D8DC"]

    // ── Production / fulfillment ──
    requisition [label="Requisition" fillcolor="#FCF3CF"]
    workflow [label="Work Flow\n(Action)" shape=octagon fillcolor="#F5CBA7"]
    workorder [label="Work Order\n(WorkOrder)" fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/transactions/models/workorder.py" target="_blank" tooltip="Work order completion — production items enter inventory.\nModel: apps/transactions/models/workorder.py\nFunctions:
  complete_workorder @ apps/transactions/services/flow.py:361 (WO completion)
  Pending.objects.create @ apps/transactions/services/flow.py:452 (+on_hand, -on_wo)\nPending deltas: on_hand: +qty, on_wo: -qty"]
    item [label="Item\n(Inventory)" fillcolor="#FCF3CF" URL="vscode://file/Users/williamjames/Documents/CommerceExpert/webClerk3/apps/products/models/item.py:196" target="_blank" tooltip="Product with quantity JSON tracking all inventory buckets.\nModel: apps/products/models/item.py:196\nFunctions:
  Item.quantity @ apps/products/models/item.py:238 (JSONField with on_hand, allocated, available, on_p, on_so, on_in, on_po, on_wo, on_r)"]
    po [label="Purchase\nOrder" fillcolor="#FCF3CF"]

    // ── Journals ──
    sales_jrnl [label="Process\nSales Journals" fillcolor="#D5F5E3"]
    cash_jrnl [label="Process\nCash Journals" fillcolor="#D5F5E3"]
    purch_jrnl [label="Process\nPurchase Journals" fillcolor="#D5F5E3"]
    gl [label="Interface to\nGeneral Ledger\n(JournalEntry)" fillcolor="#ABEBC6"]

    // ── Right sidebar: modules ──
    subgraph cluster_modules {
        label="Modules"
        style=filled
        fillcolor="#F8F9F9"
        color="#BDC3C7"

        mod_setup [label="Setup\n(Setting)" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_sales [label="Sales" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_orderentry [label="Order Entry" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_mgmt [label="Management" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_acct [label="Accounting" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_reports [label="databrowser\nReports" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_docs [label="Documents\n(Document)" shape=box fillcolor="#EAECEE" fontsize=8]
        mod_alice [label="Alice\n(AI Assistant)" shape=box fillcolor="#AED6F1" fontsize=8]
    }

    // ── Edges: main flow ──
    market -> comms
    comms -> objectives
    comms -> contact
    contact -> proposal
    proposal -> order
    order -> backorder [label="partial"]
    order -> invoice [label="complete"]
    backorder -> order [style=dashed]
    invoice -> payment
    objectives -> forecast
    objectives -> risk [dir=both]
    forecast -> risk [style=dashed]

    // ── Edges: production ──
    contact -> requisition [style=dashed]
    requisition -> workflow
    workflow -> workorder
    workorder -> order [label="materials\ntimes" style=dashed]
    item -> order [style=dashed]
    po -> item [label="inship"]
    requisition -> po [style=dashed]
    forecast -> po [style=dashed]

    // ── Edges: journals ──
    invoice -> sales_jrnl
    payment -> cash_jrnl
    po -> purch_jrnl
    sales_jrnl -> gl
    cash_jrnl -> gl
    purch_jrnl -> gl

    // ── Module connections ──
    mod_setup -> comms [style=invis]
    mod_alice -> payment [style=dashed label="pattern\nrecognition" fontsize=7]
}
