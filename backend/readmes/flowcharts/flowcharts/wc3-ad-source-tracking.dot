// WC3 Ad Source Tracking — campaign ROI measurement
// From wc2 page 22: Ad Source metrics from leads through invoices
// Render: dot -Tpdf wc3-ad-source-tracking.dot -o wc3-ad-source-tracking.pdf

digraph wc3_ad_source {
    rankdir=LR
    fontname="Helvetica Neue"
    fontsize=12
    bgcolor="#FAFAFA"
    node [fontname="Helvetica Neue" fontsize=10 style="filled,rounded" shape=box
          color="#CCCCCC" penwidth=0.8]
    edge [fontname="Helvetica Neue" fontsize=8 color="#888888" penwidth=0.8]
    label="WC3 — Ad Source Tracking\nCampaign ROI: source → lead → customer → revenue"
    labelloc=t
    fontsize=15
    pad=0.6
    nodesep=0.5
    ranksep=1.0

    // ── New record triggers ──
    subgraph cluster_new {
        label="New Record Events"
        style="filled,rounded"
        fillcolor="#E8F5E9"
        color="#A5D6A7"
        fontsize=9
        fontcolor="#2E7D32"

        new_lead [label="New Lead" fillcolor="#C8E6C9" color="#81C784"]
        new_cust [label="New Customer" fillcolor="#C8E6C9" color="#81C784"]
    }

    // ── Value change triggers ──
    subgraph cluster_value {
        label="Value Change Events"
        style="filled,rounded"
        fillcolor="#FFF8E1"
        color="#FFE082"
        fontsize=9
        fontcolor="#F57F17"

        proposals [label="Proposals" fillcolor="#FFF9C4" color="#FFF176"]
        orders [label="Orders" fillcolor="#FFF9C4" color="#FFF176"]
        invoices [label="Invoices" fillcolor="#FFF9C4" color="#FFF176"]
        services [label="Services" fillcolor="#FFF9C4" color="#FFF176"]
    }

    // ── Ad Source record ──
    ad_source [label="Ad Source Record\n(metadata.source)\n\nCost per lead\n# new leads/customers\n# of leads\n$ value of sales\n$ value of 1st orders\nPlan to Actual\n\nPacing item performance"
              fillcolor="#E8EAF6" color="#7986CB" fontsize=10]

    // ── Output ──
    roi [label="Campaign ROI\nsource → order\n→ cost to acquire" fillcolor="#F3E5F5"
         color="#CE93D8" fontsize=10]

    alice [label="Alice\ntrack effectiveness\nflag waste" fillcolor="#B3E5FC"
           color="#4FC3F7" fontsize=9]

    // ── Edges ──
    new_lead -> ad_source [label="count\nnew" color="#66BB6A"]
    new_cust -> ad_source [label="count\nconverted" color="#66BB6A"]

    proposals -> ad_source [label="$ value" color="#FFB300"]
    orders -> ad_source [label="$ value" color="#FFB300"]
    invoices -> ad_source [label="$ value" color="#FFB300"]
    services -> ad_source [label="count" style=dashed color="#FFB300"]

    ad_source -> roi [color="#AB47BC"]
    roi -> alice [style=dashed color="#29B6F6"]
}
